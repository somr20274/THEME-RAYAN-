{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    assign btn_shadow_sp = settings.btn_shadow_sp

    case section.settings.img_orientation
        when 'square'
            assign img_width  = 900
            assign img_height = 900
        when 'landscape'
            assign img_width  = 900
            assign img_height = 720
        when 'landscape-x2'
            assign img_width  = 900
            assign img_height = 600
        when 'portrait'
            assign img_width  = 720
            assign img_height = 900
        when 'portrait-x2'
            assign img_width  = 600
            assign img_height = 900
    endcase

    assign brand_img_width = section.settings.brand_image_size

    assign classes = ''
    assign classes = classes | append: section.settings.img_style | append: ' ' 
    assign classes = classes | append: section.settings.border | append: ' '
    assign classes = classes | append: section.settings.border_color | append: ' ' 
    assign classes = classes | append: 'border-' | append: section.settings.border_width | append: ' ' 
    assign classes = classes | append: section.settings.shadow_sp | append: ' ' 
    assign classes = classes | strip

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

{% style %}
  /* Readmore Shopiweb */
  #image-compare-{{ section.id }} .limited-readmore .bottom-readmore {
    background: linear-gradient(to bottom,rgb(255 255 255 / 0%),{{ section.settings.readmore_color }});
  }
  #image-compare-{{ section.id }} .read-more-checker ~ .read-more-button:before {
    content: "{{ section.settings.text_voirplus }}";
  }
  #image-compare-{{ section.id }} .read-more-checker:checked ~ .read-more-button:before {
    content: "{{ section.settings.text_voirmoins }}";
  }
{% endstyle %}

<link href="{{ 'vendor-image-compare-viewer.min.css' | asset_url }}" rel="stylesheet" media="print" onload="this.media='all'">
<script src="{{ 'vendor-image-compare-viewer.min.js' | asset_url }}" defer></script>

<section 
    id="image-compare-{{ section.id }}" 
    class="image-compare enter-view overflow-hidden {{ bg_class }} {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"
  
    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}
    
    <div class="{{ section.settings.container }} position-relative z-1">
        <div class="mx-auto" 
            {% if section.settings.container == 'container-fluid' %}
                style="max-width: {{ section.settings.max_width }}px;"
            {% endif %}>
            <div class="row align-items-center {{ section.settings.img_align_desktop }}">
                <div class="mb-8 mb-lg-0 {% if section.settings.desktop_image_width == 'small' %}col-lg-4{% elsif section.settings.desktop_image_width == 'large' %}col-lg-8{% else %}col-lg-6{% endif %}">
                    <div 
                        class="animate__animated animate__faster opacity-0"
                        data-animate-class="animate__fadeIn"
                        style="animation-delay: 0ms">
                        {% if section.settings.image_before == blank %}
                            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg rounded' }}
                        {% else %}
                            <div 
                                class="image-compare-slider {{ classes }}"
                                data-control-color="{{ section.settings.controlColor }}"
                                data-add-circle="{{ section.settings.addCircle }}"
                                data-show-labels="{{ section.settings.show_labels }}"
                                data-label-before="{{ section.settings.label_before }}"
                                data-label-after="{{ section.settings.label_after }}"
                                data-label-on-hover="{{ section.settings.label_on_hover }}"
                                data-smoothing="{{ section.settings.smoothing }}"
                                data-smoothing-amount="{{ section.settings.smoothing_amount }}"
                                data-hover-start="{{ section.settings.hover_start }}"
                                data-vertical-mode="{{ section.settings.vertical_mode }}"
                                data-starting-point="{{ section.settings.starting_point }}">
                                <img
                                    class="img-fluid"
                                    src="{{ section.settings.image_before.src | image_url: width: img_width, height: img_height, crop: section.settings.img_crop }}"
                                    alt="{{ section.settings.image_before.alt | escape }}"
                                    width="{{ img_width }}"
                                    height="{{ img_height }}"
                                    loading="lazy">
                                <img
                                    class="img-fluid"
                                    src="{{ section.settings.image_after.src | image_url: width: img_width, height: img_height, crop: section.settings.img_crop }}"
                                    alt="{{ section.settings.image_after.alt | escape }}"
                                    width="{{ img_width }}"
                                    height="{{ img_height }}"
                                    loading="lazy">
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="{% if section.settings.desktop_image_width == 'small' %}col-lg-8{% elsif section.settings.desktop_image_width == 'large' %}col-lg-4{% else %}col-lg-6{% endif %}">
                    {% unless section.settings.subtitle_img == blank %}
                        <div 
                            class="animate__animated animate__faster opacity-0"
                            {% if settings.effect_apply_caption_enable %}
                              data-animate-class="{{ settings.animation_caption_name }}"
                              style="animation-delay: 1200ms;"
                            {% endif %}>
                                <img
                                    class="img-fluid mb-5"
                                    src="{{ section.settings.subtitle_img.src | image_url: width: brand_img_width }}"
                                    alt="{{ section.settings.subtitle_img.alt | escape }}"
                                    width="{{ brand_img_width }}"
                                    height="auto"
                                    loading="lazy">
                            </div>
                    {% endunless %}
                    
                    {% unless section.settings.subtitle == blank %}
                        <div 
                            class="animate__animated animate__faster opacity-0"
                            {% if settings.effect_apply_caption_enable %}
                              data-animate-class="{{ settings.animation_caption_name }}"
                              style="animation-delay: 1000ms;"
                            {% endif %}>
                                <p class="subtitle text-uppercase fw-500 mb-3 {{ section.settings.subtitle_size }}"
                                    style="color:{{ section.settings.color_caption }};">
                                    {{ section.settings.subtitle }}
                                </p>
                        </div>
                    {% endunless %} 

                    {% unless section.settings.subtitle_badge1 == blank and section.settings.subtitle_badge2 == blank %}
                        <div 
                            class="animate__animated animate__faster opacity-0"
                            {% if settings.effect_apply_caption_enable %}
                              data-animate-class="{{ settings.animation_caption_name }}"
                              style="animation-delay: 1000ms;"
                            {% endif %}>
                            <div class="badge-group mb-5">
                                {% unless section.settings.subtitle_badge1 == blank %}
                                    <span class="badge d-inline-block me-2 {{ section.settings.subtitle_badge_size }} {{ section.settings.color_subtitle_badge1 }}"
                                          style="box-shadow: #000 0 3px 10px -5px;">
                                        {{ section.settings.subtitle_badge1 }}
                                    </span>
                                {% endunless %}
                                {% unless section.settings.subtitle_badge2 == blank %}
                                    <span class="badge d-inline-block me-2 {{ section.settings.subtitle_badge_size }} {{ section.settings.color_subtitle_badge2 }}"
                                          style="box-shadow: #000 0 3px 10px -5px;">
                                        {{ section.settings.subtitle_badge2 }}
                                    </span>
                                {% endunless %}
                            </div>
                        </div>
                    {% endunless %}

                    {% unless section.settings.title == blank %}
                        <div class="overlay-text-container my-4" style="position: relative;">
                            <{{ section.settings.heading_tag }} class="title enter-view {{ section.settings.title_size }} animate__animated animate__faster opacity-0
                                {% if section.settings.highlighted_text_style != 'none' %}
                                    mb-7
                                {% else %}
                                    mb-5
                                {% endif %}"
                                {% if settings.effect_apply_title_enable %}
                                  data-animate-class="{{ settings.animation_title_name }}"
                                  style="animation-delay: 200ms;"
                                {% endif %}>
                    
                                {% assign highlighted_title = section.settings.title %}
                                {% assign svg_parts = highlighted_title | split: '<em>' %}
                                {% for part in svg_parts %}
                                    {% if forloop.index == 1 %}
                                        {{ part }}
                                    {% elsif forloop.index == 2 %}
                                        {% assign end_svg = part | split: '</em>' %}
                                        {% if section.settings.italic_color_option == 'none' and section.settings.highlighted_text_style == 'none' %}
                                            <em>{{ end_svg[0] }}</em>
                                        {% else %}
                                            &nbsp;<span class="background-animate" style="position: relative; display: inline-block;
                                                {% if section.settings.italic_color_option == 'apply_color' and section.settings.highlight_color != blank %}
                                                    color: {{ section.settings.highlight_color }};
                                                {% elsif section.settings.italic_color_option == 'stencil' %}
                                                    -webkit-text-stroke: .02em currentColor;
                                                    -webkit-text-fill-color: transparent;
                                                {% elsif section.settings.italic_color_option == 'background_cover' %}
                                                    background-repeat: no-repeat;
                                                    background-image: linear-gradient(to right, {{ section.settings.highlight_color }} 0%, transparent 100%), 
                                                                      linear-gradient(to right, {{ section.settings.highlight_color }} 0%, transparent 100%);
                                                    background-position: left 70%;
                                                {% elsif section.settings.italic_color_option == 'gradient_color' %}
                                                    -webkit-background-clip: text;
                                                    -webkit-text-fill-color: transparent;
                                                    background-repeat: no-repeat;
                                                    background-image: {{ section.settings.title_gradient_color }};
                                                    background-position: left 85%;
                                                {% endif %}">
                                                {{ end_svg[0] }}
                                                {% if section.settings.highlighted_text_style != 'none' and section.settings.highlight_color != blank %}
                                                    {% render 'svg-title', svg_name: section.settings.highlighted_text_style, stroke_color: section.settings.highlight_color %}
                                                {% endif %}
                                            </span>&nbsp;
                                        {% endif %}
                                        {{ end_svg[1] }}
                                    {% else %}
                                        {{ part }}
                                    {% endif %}
                                {% endfor %}
                            
                                {% if section.settings.show_svg_h2 %}
                                    {% if settings.custom_svg_h2 != blank %}
                                        <div class="h2_svg animate__animated animate__faster opacity-0"
                                            {% if settings.effect_apply_svg_enable %} 
                                              data-animate-class="{{ settings.animation_svg_name }}"
                                              style="animation-delay: 400ms;"
                                            {% endif %}
                                        >
                                            <span style="fill:{{ settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {{ settings.custom_svg_h2 }}</span>
                                        </div>
                                    {% else %}
                                        {% if settings.svg_h2 != 'none' %}
                                            <div class="h2_svg mb-4 animate__animated animate__faster opacity-0"
                                                {% if settings.effect_apply_svg_enable %} 
                                                  data-animate-class="{{ settings.animation_svg_name }}"
                                                  style="animation-delay: 400ms;"
                                                {% endif %}
                                            >
                                                <span style="fill:{{ settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {% render 'svg-subtitle', svg_h2: settings.svg_h2 %}</span>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                {% endif %}
                            </{{ section.settings.heading_tag }}>
                        </div>
                    {% endunless %}

                    {% if section.settings.readmore %}
                        <div class="holder-readmore">
                            <input type="checkbox" class="read-more-checker" id="read-more-checker--{{ section.id }}" />
                            <div class="limited-readmore l-{{ section.settings.formread }} mb-4">
                                {% unless section.settings.description == blank %}
                                    <div 
                                        class="animate__animated animate__faster opacity-0"
                                        {% if settings.effect_apply_description_enable %} 
                                            data-animate-class="{{ settings.animation_description_name }}"
                                            style="animation-delay: 600ms;"
                                          {% endif %}>
                                        <div class="description rte mb-7 {{ section.settings.description_size }}">
                                            {{ section.settings.description }}
                                        </div>
                                    </div>
                                {% endunless %}
                            <div class="bottom-readmore">&nbsp</div>
                            </div>
                            <label for="read-more-checker--{{ section.id }}" class="read-more-button mb-6 animate__animated animate__faster opacity-0"
                                    {% if settings.effect_apply_description_enable %} 
                                      data-animate-class="{{ settings.animation_description_name }}"
                                      style="animation-delay: 600ms;"
                                    {% endif %}></label>
                        </div>
                    {% else %}
                        {% unless section.settings.description == blank %}
                            <div 
                                class="animate__animated animate__faster opacity-0"
                                {% if settings.effect_apply_description_enable %} 
                                    data-animate-class="{{ settings.animation_description_name }}"
                                    style="animation-delay: 600ms;"
                                  {% endif %}>
                                <div class="description rte mb-7 {{ section.settings.description_size }}">
                                    {{ section.settings.description }}
                                </div>
                            </div>
                        {% endunless %}
                    {% endif %}
                          
                    {% unless section.settings.btn_text == blank %}
                        <div 
                            class="d-inline-flex animate__animated animate__faster opacity-0"
                            {% if settings.effect_apply_btn_enable %} 
                              data-animate-class="{{ settings.animation_btn_name }}"
                              style="animation-delay: 800ms;"
                            {% endif %}>
                            <a 
                                class="btn {{ section.settings.btn_color }} {{ btn_shadow_sp }} {{ section.settings.btn_size }}"
                                href="{{ section.settings.btn_url }}">
                                {{ section.settings.btn_text }}
                            </a>
                        </div>
                    {% endunless %}
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Image comparaison",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "paragraph", 
            "content": "Documentation FR : [Images Comparaison by Shopiweb](https:\/\/www.docs.shopiweb.fr\/theme-premium\/documentation\/sections\/image-comparaison)"
        },
        {
            "type": "header",
            "content": "Général"
        }, 
        {
            "type": "select",
            "id": "bg_type",
            "label": "Type d'arrière-plan",
            "default": "predefined",
            "options": [
                { "value": "predefined", "label": "Couleur" },
                { "value": "custom", "label": "Fondu" },
                { "value": "image", "label": "Image" }
            ]
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Couleur d'arrière plan",
            "default": "bg-body text-body",
            "options": [
                { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
                { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
                { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
            ],
            "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé ou une image d'arrière-plan."
        },
        {
            "type": "color_background",
            "id": "bg_gradient_color",
            "label": "Dégradé personnalisé",
            "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
            "visible_if": "{{ section.settings.bg_type == 'custom' }}"
        },
        {
            "type": "image_picker",
            "id": "background_img",
            "label": "Image d'arrière-plan",
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_opacity",
            "label": "Opacité",
            "min": 0,
            "max": 1,
            "step": 0.1,
            "default": 0.3,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_blur",
            "label": "Flou",
            "min": 0,
            "max": 10,
            "step": 1,
            "default": 0,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "header",
            "content": "Mise en page"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Conteneur",
            "default": "container",
            "options": [
                { "value": "container", "label": "Page" },
                { "value": "container-fluid", "label": "Personnalisé" }
            ]
        },
        {
            "type": "text",
            "id": "max_width",
            "label": "Largeur max. (px)",
            "default": "991",
            "visible_if": "{{ section.settings.container == 'container-fluid' }}"
        },
        {
            "type": "select",
            "id": "desktop_image_width",
            "label": "Largeur d'image sur ordinateur",
            "info": "L'image est automatiquement optimisée pour les mobiles.",
            "default": "medium",
            "options": [
                { "value": "small", "label": "25%" },
                { "value": "medium", "label": "50%" },
                { "value": "large", "label": "75%" }
            ]
        },
        {
            "type": "select",
            "id": "text_align_mobile",
            "label": "Alignement du texte - mobile",
            "default": "text-center",
            "options": [
                { "value": "text-start", "label": "Gauche" },
                { "value": "text-center", "label": "Centre" },
                { "value": "text-end", "label": "Droite" }
            ]
        },
        {
            "type": "select",
            "id": "text_align_desktop",
            "label": "Alignement du texte - bureau",
            "default": "text-lg-start",
            "options": [
                { "value": "text-lg-start", "label": "Gauche" },
                { "value": "text-lg-center", "label": "Centre" },
                { "value": "text-lg-end", "label": "Droite" }
            ]
        },
        {
            "type": "header",
            "content": "Image"
        },
        {
            "type": "image_picker",
            "id": "image_before",
            "label": "Image - Avant"
        },
        {
            "type": "image_picker",
            "id": "image_after",
            "label": "Image - Après"
        },
        {
            "type": "select",
            "id": "img_orientation",
            "label": "Image orientation",
            "default": "landscape",
            "options": [
                { "value": "square", "label": "Carré" },
                { "value": "landscape", "label": "Paysage" },
                { "value": "landscape-x2", "label": "Paysage 2x" },
                { "value": "portrait", "label": "Portrait" },
                { "value": "portrait-x2", "label": "Portrait 2x" }
            ]
        },
        {
            "type": "select",
            "id": "img_crop",
            "label": "Recadrage de l'image",
            "default": "center",
            "options": [
                { "value": "top", "label": "Haut" },
                { "value": "center", "label": "Centre" },
                { "value": "bottom", "label": "Bas" },
                { "value": "left", "label": "Gauche" },
                { "value": "right", "label": "Droite" }
            ]
        },
        {
            "type": "select",
            "id": "img_style",
            "label": "Style d'angle",
            "options": [
              { "value": "rounded-0", "label": "Pas d'arrondi" },
              { "value": "rounded", "label": "Image arrondi complet" },
              { "value": "rounded-top", "label": "Image arrondi en haut" },
              { "value": "rounded-bottom", "label": "Image arrondi en bas" },
              { "value": "rounded-start", "label": "Image arrondi à gauche" },
              { "value": "rounded-end", "label": "Image arrondi à droite" }
            ],
            "default": "rounded"
        },
        {
            "type": "select",
            "id": "border",
            "label": "Bordure de l'image",
            "default": "border",
            "options": [
                { "value": "", "label": "Aucune" },
                { "value": "border", "label": "Bordure" }
            ]
        },
        {
            "type": "select",
            "id": "border_color",
            "label": "Couleur de la bordure",
            "options": [
                { "value": "", "label": "Default" },
                { "value": "border-primary", "label": "Primaire" },
                { "value": "border-secondary", "label": "Secondaire" },
                { "value": "border-tertiary", "label": "Tertiaire" },
                { "value": "border-dark", "label": "Sombre" },
                { "value": "border-success", "label": "Succès" },
                { "value": "border-warning", "label": "Avertissement" },
                { "value": "border-danger", "label": "Danger" },
                { "value": "border-info", "label": "Info" }
            ],
            "default": "",
            "visible_if": "{{ section.settings.border == 'border' }}"
        },
        {
            "type": "range",
            "id": "border_width",
            "label": "Largeur de la bordure",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 1,
            "visible_if": "{{ section.settings.border == 'border' }}"
        },
        {
            "type": "select",
            "id": "shadow_sp",
            "label": "Ombre",
            "options": [
                { "value": "shadow-none", "label": "Aucune" },
                { "value": "shadow-1", "label": "Ombre légère" },
                { "value": "shadow-2", "label": "Ombre partiel" },
                { "value": "shadow-3", "label": "Ombre profonde" },
                { "value": "shadow-4", "label": "Ombre totale" }
            ],
            "default": "shadow-1"
        },
        {
            "type": "select",
            "id": "img_align_desktop",
            "label": "Alignement de l'image (bureau)",
            "default": "flex-lg-row",
            "options": [
                { "value": "flex-lg-row", "label": "Gauche" },
                { "value": "flex-lg-row-reverse", "label": "Droite" }
            ]
        },
        {
            "type": "header",
            "content": "Curseur de comparaison",
            "info": "REMARQUE : En raison du fonctionnement de l'éditeur de thème d'administration de Shopify, vous devez d'abord enregistrer les modifications pour que le script fonctionne."
        },
        {
            "type": "color",
            "id": "controlColor",
            "label": "Couleur de contrôle",
            "default": "#ffffff"
        },
        {
            "type": "checkbox",
            "id": "addCircle",
            "label": "Ajouter un cercle",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_labels",
            "label": "Afficher les étiquettes",
            "default": true
        },
        {
            "type": "text",
