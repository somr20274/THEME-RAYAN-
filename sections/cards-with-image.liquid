{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    assign btn_shadow_sp = settings.btn_shadow_sp

    if section.settings.breakpoint_xs_scroll
        assign row_xs = 'xs-scroll'
    else
        assign row_xs = section.settings.breakpoint_xs | prepend: 'row-cols-'
    endif

    assign row_sm = section.settings.breakpoint_sm | prepend: 'row-cols-sm-'
    assign row_md = section.settings.breakpoint_md | prepend: 'row-cols-md-'
    assign row_lg = section.settings.breakpoint_lg | prepend: 'row-cols-lg-'
    assign row_xl = section.settings.breakpoint_xl | prepend: 'row-cols-xl-'
    assign row_xxl = section.settings.breakpoint_xxl | prepend: 'row-cols-xxl-'

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<section 
    id="cards-with-image-{{ section.id }}" 
    class="cards-with-image enter-view position-relative overflow-hidden {{ bg_class }} {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"
  
    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}

    <div 
        class="{{ section.settings.container }} position-relative" 
        {% if section.settings.container == 'container-fluid' %}
           style="max-width: {{ section.settings.max_width }}px;"
        {% endif %}
    >
        {% render 'section-header' %}
        
        <div class="row 
                    {{ section.settings.product_card_spacing_mobile | prepend: 'mx-n' }} {{ section.settings.product_card_spacing_desktop | prepend: 'mx-lg-n' }}
                    {{ row_xs }} {{ row_sm }} {{ row_md }} {{ row_lg }} {{ row_xl }} {{ row_xxl }}">
            {% for block in section.blocks %}
                {% liquid 
                    case block.settings.img_orientation
                        when 'square'
                            assign img_width  = 600
                            assign img_height = 600
                        when 'landscape'
                            assign img_width  = 600
                            assign img_height = 480
                        when 'portrait'
                            assign img_width  = 480
                            assign img_height = 600
                    endcase
                %}
                <div class="col {{ section.settings.product_card_spacing_mobile | prepend: 'p-' }} {{ section.settings.product_card_spacing_desktop | prepend: 'p-lg-' }}" {{ block.shopify_attributes }}>
                    <div 
                        class="h-100 {% if block.settings.bg_type == 'glass-bg' %}glass-bg {% endif %} {% unless section.settings.animation == '' %}animate__animated opacity-0 {{ section.settings.animation_speed }}{% endunless %}"
                        data-animate-class="{{ section.settings.animation }}"
                        style="animation-delay: {{ forloop.index | times: 150 }}ms;">
                        {% liquid 
                            if block.settings.bg_type == 'custom'
                                assign text_color_class = block.settings.bg_color | split: " " | last
                                assign bg_class = 'content-bg-gradient ' | append: text_color_class
                            elsif block.settings.bg_type == 'glass-bg'
                                assign text_color_class = block.settings.bg_color | split: " " | last
                                assign bg_class = 'bg-transparent ' | append: text_color_class
                            else
                                assign bg_class = block.settings.bg_color
                            endif
                          
                            assign classes = '' 
                            if block.settings.enable_border == false
                                assign classes = classes | append: 'border-0 '
                            else
                                assign classes = classes | append: block.settings.border_color | append: ' ' 
                                assign classes = classes | append: 'border-' | append: block.settings.border_width | append: ' '
                            endif
                            assign classes = classes | append: block.settings.shadow_sp | append: ' ' 
                            assign classes = classes | strip
                        %}
                        <div 
                            class="card {{ bg_class }} {{ classes }}"
                            style="{% if block.settings.bg_type == 'custom' %}background: {{ block.settings.bg_gradient_color }};{% endif %}">

                            {% if block.settings.img_position == 'top' %}
                                {% unless block.settings.img == blank %}
                                    <img
                                        class="img-fluid card-img-top {% unless block.settings.title != blank or block.settings.description != blank or block.settings.btn_text != blank %}card-img-bottom{% endunless %}"
                                        src="{{ block.settings.img.src | image_url: width: img_width, height: img_height, crop: block.settings.img_crop }}"
                                        alt="{{ block.settings.img.alt | escape }}"
                                        width="{{ img_width }}"
                                        height="{{ img_height }}"
                                        loading="lazy">
                                {% endunless %}
                            {% endif %}
                            {% if block.settings.title != blank or block.settings.description != blank or block.settings.btn_text != blank %}
                                <div class="card-body {{ block.settings.text_align_mobile }} {{ block.settings.text_align_desktop }}">
                                    {% unless block.settings.title == blank %}
                                        <{{ block.settings.heading_tag }} class="title mb-4 {{ block.settings.title_size }}">
                                            {{ block.settings.title }}
                                        </{{ block.settings.heading_tag }}>
                                    {% endunless %}
                                    {% unless block.settings.description == blank %}
                                        <div class="description rte mb-0 {{ block.settings.description_size }}">
                                            {{ block.settings.description }}
                                        </div>
                                    {% endunless %}
                                    {% unless block.settings.btn_text == blank %}
                                        <a class="btn mt-5 mb-3 w-100 {{ block.settings.btn_color }} {{ btn_shadow_sp }} {{ block.settings.btn_size }}" href="{{ block.settings.btn_url }}">
                                            {{ block.settings.btn_text }}
                                        </a>
                                    {% endunless %}
                                </div>
                            {% endif %}

                            {% if block.settings.img_position == 'bottom' %}
                                {% unless block.settings.img == blank %}
                                    <img
                                        class="img-fluid card-img-bottom {% unless block.settings.title != blank or block.settings.description != blank or block.settings.btn_text != blank %}card-img-top{% endunless %}"
                                        src="{{ block.settings.img.src | image_url: width: img_width, height: img_height, crop: block.settings.img_crop }}"
                                        alt="{{ block.settings.img.alt | escape }}"
                                        width="{{ img_width }}"
                                        height="{{ img_height }}"
                                        loading="lazy">
                                {% endunless %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Cartes image",
    "settings": [
