{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}
  
<section id="counter-elite-{{ section.id }}" 
         class="counter-elite enter-view {{ bg_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"

         {% if section.settings.bg_type == 'image' %}
            style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
                   background-size: cover; 
                   background-repeat: no-repeat; 
                   background-position: center center;
                   position: relative;"
        {% elsif section.settings.bg_type == 'custom' %}
            style="background: {{ section.settings.bg_gradient_color }};"
        {% endif %}>
    
        {% if section.settings.bg_type == 'image' %}
            <div class="background-overlay" 
                 style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
            </div>
            <div class="background-overlay-blur" 
                 style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                        -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
            </div>
        {% endif %}

   <div class="countdown-banner-{{ section.id }}-wrapper {{ section.settings.container }} mx-auto" 
        {% if section.settings.container == 'container-fluid' %}
           style="max-width: {{ section.settings.max_width }}px;"
        {% endif %}>

    <div
      class="countdown-banner-{{ section.id }}">
      
      <div class="countdown-banner-content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'text' %}
              <div class="countdown-banner-text-{{ section.id }}-{{ block.id }} {{ block.settings.text_align_mobile }} {{ block.settings.text_align_desktop }}" {{ block.shopify_attributes }}>
                {% unless block.settings.subtitle_img == blank %}
                    <div 
                        class="animate__animated animate__faster opacity-0"
                        {% if settings.effect_apply_caption_enable %}
                          data-animate-class="{{ settings.animation_caption_name }}"
                          style="animation-delay: 1200ms;"
                        {% endif %}>
                            <img
                                class="img-fluid mb-5"
                                src="{{ block.settings.subtitle_img.src | image_url: width: block.settings.brand_image_size }}"
                                alt="{{ block.settings.subtitle_img.alt | escape }}"
                                width="{{ block.settings.brand_image_size }}"
                                height="auto"
                                loading="lazy">
                        </div>
                {% endunless %}
                {% unless block.settings.subtitle == blank %}
                    <div 
                        class="animate__animated animate__faster opacity-0"
                        {% if settings.effect_apply_caption_enable %}
                          data-animate-class="{{ settings.animation_caption_name }}"
                          style="animation-delay: 1000ms;"
                        {% endif %}>
                            <p class="subtitle text-uppercase fw-500 mb-3 {{ block.settings.subtitle_size }}"
                                style="color:{{ block.settings.color_caption }};">
                                {{ block.settings.subtitle }}
                            </p>
                    </div>
                {% endunless %} 
                {% unless block.settings.title == blank %}
                    <div class="overlay-text-container my-4" style="position: relative;">
                        <{{ block.settings.heading_tag }} class="title enter-view {{ block.settings.title_size }} animate__animated animate__faster opacity-0
                            {% if block.settings.highlighted_text_style != 'none' %}
                                mb-7
                            {% else %}
                                mb-5
                            {% endif %}"
                            {% if settings.effect_apply_title_enable %}
                              data-animate-class="{{ settings.animation_title_name }}"
                              style="animation-delay: 200ms;"
                            {% endif %}>
                
                            {% assign highlighted_title = block.settings.title %}
                            {% assign svg_parts = highlighted_title | split: '<em>' %}
                            {% for part in svg_parts %}
                                {% if forloop.index == 1 %}
                                    {{ part }}
                                {% elsif forloop.index == 2 %}
                                    {% assign end_svg = part | split: '</em>' %}
                                    {% if block.settings.italic_color_option == 'none' and block.settings.highlighted_text_style == 'none' %}
                                        <em>{{ end_svg[0] }}</em>
                                    {% else %}
                                        &nbsp;<span class="background-animate" style="position: relative; display: inline-block;
                                            {% if block.settings.italic_color_option == 'apply_color' and block.settings.highlight_color != blank %}
                                                color: {{ block.settings.highlight_color }};
                                            {% elsif block.settings.italic_color_option == 'stencil' %}
                                                -webkit-text-stroke: .02em currentColor;
                                                -webkit-text-fill-color: transparent;
                                            {% elsif block.settings.italic_color_option == 'background_cover' %}
                                                background-repeat: no-repeat;
                                                background-image: linear-gradient(to right, {{ block.settings.highlight_color }} 0%, transparent 100%), 
                                                                  linear-gradient(to right, {{ block.settings.highlight_color }} 0%, transparent 100%);
                                                background-position: left 70%;
                                            {% elsif block.settings.italic_color_option == 'gradient_color' %}
                                                -webkit-background-clip: text;
                                                -webkit-text-fill-color: transparent;
                                                background-repeat: no-repeat;
                                                background-image: {{ block.settings.title_gradient_color }};
                                                background-position: left 85%;
                                            {% endif %}">
                                            {{ end_svg[0] }}
                                            {% if block.settings.highlighted_text_style != 'none' and block.settings.highlight_color != blank %}
                                                {% render 'svg-title', svg_name: block.settings.highlighted_text_style, stroke_color: block.settings.highlight_color %}
                                            {% endif %}
                                        </span>&nbsp;
                                    {% endif %}
                                    {{ end_svg[1] }}
                                {% else %}
                                    {{ part }}
                                {% endif %}
                            {% endfor %}
                        
                            {% if block.settings.show_svg_h2 %}
                                {% if settings.custom_svg_h2 != blank %}
                                    <div class="h2_svg animate__animated animate__faster opacity-0"
                                        {% if settings.effect_apply_svg_enable %} 
                                          data-animate-class="{{ settings.animation_svg_name }}"
                                          style="animation-delay: 400ms;"
                                        {% endif %}
                                    >
                                        <span style="fill:{{ block.settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {{ settings.custom_svg_h2 }}</span>
                                    </div>
                                {% else %}
                                    {% if settings.svg_h2 != 'none' %}
                                        <div class="h2_svg mb-4 animate__animated animate__faster opacity-0"
                                            {% if settings.effect_apply_svg_enable %} 
                                              data-animate-class="{{ settings.animation_svg_name }}"
                                              style="animation-delay: 400ms;"
                                            {% endif %}
                                        >
                                            <span style="fill:{{ block.settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {% render 'svg-subtitle', svg_h2: settings.svg_h2 %}</span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                        </{{ block.settings.heading_tag }}>
                    </div>
                {% endunless %}
                {% unless block.settings.description == blank %}
                    <div class="description rte text-muted mt-n2 {{ block.settings.description_size }} animate__animated animate__faster opacity-0"
                         {% if settings.effect_apply_description_enable %} 
                            data-animate-class="{{ settings.animation_description_name }}"
                            style="animation-delay: 600ms;"
                         {% endif %}
                    >
                        {{ block.settings.description }}
                    </div>
                {% endunless %}
              </div>
            {% when 'timer' %}
              <style>
                .timer-countdown-{{ section.id }}-{{ block.id }} {
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  flex-grow: 1;
                  /*margin-top: 16px;*/
                  /*margin-bottom: 16px;*/
                  align-items: stretch;
                }
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-block {
                  position: relative;
                  border-radius: 12px;
                  /*padding: 20px;*/
                  padding: 0 1rem;
                }
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-block__num,
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-block__unit {
                  display: block;
                  text-align: center;
                }
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-block__num {
                  font-size: 25px;
                  line-height: 1.2;
                  font-weight: 700;
                  margin-bottom: 4px;
                }
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-block__unit {
                  text-transform: uppercase;
                  margin-top: 6px;
                  font-size: 10px;
                }
                @media (min-width: 750px) {
                  .timer-countdown-{{ section.id }}-{{ block.id }} .time-block__unit {
                    font-size: 12px;
                  }
                }
                .timer-countdown-{{ section.id }}-{{ block.id }} .time-divier {
                  position: relative;
                  width: 1px;
                  min-height: 100%;
                  background-color: var(--color);
                }
              </style>

              <div
                class="timer-countdown-{{ section.id }}-{{ block.id }}"{{ block.shopify_attributes }}
                style="color: {{ block.settings.color }}; --color: {{ block.settings.color }};"
              >
                <div class="time-block">
                  <span class="time-block__num js-timer-days">00</span>
                  <span class="time-block__unit">Jours</span>
                </div>
                {% comment %} <span class="time-colon">:</span> {% endcomment %}
                <span class="time-divier"></span>
                <div class="time-block">
                  <span class="time-block__num js-timer-hours">00</span>
                  <span class="time-block__unit">Heures</span>
                </div>
                {% comment %} <span class="time-colon">:</span> {% endcomment %}
                <span class="time-divier"></span>
                <div class="time-block">
                  <span class="time-block__num js-timer-minutes">00</span>
                  <span class="time-block__unit">Minutes</span>
                </div>
                {% comment %} <span class="time-colon">:</span> {% endcomment %}
                <span class="time-divier"></span>
                <div class="time-block">
                  <span class="time-block__num js-timer-seconds">00</span>
                  <span class="time-block__unit">Secondes</span>
                </div>
              </div>

              <style>
                .timer-countdown-completed-text-{{ section.id }}-{{ block.id }} {
                  display: none;
                }
              </style>
              <div
                class="timer-countdown-completed-text-{{ section.id }}-{{ block.id }}"
              >
                {{ block.settings.timer_completed_text }}
              </div>

              <script type="text/javascript">
                (function () {

                  function startTimer() {
                    const second = 1000,
                      minute = second * 60,
                      hour = minute * 60,
                      day = hour * 24,
                      wrapper = document.querySelector(
                        '.timer-countdown-{{ section.id }}-{{ block.id }}'
                      ),
                      countDown = new Date('{{ block.settings.year }}-{{ block.settings.month }}-{{ block.settings.day }}T{{ block.settings.hour }}:{{ block.settings.minute }}:00Z').getTime();

                    console.log('start timer, end date:' + countDown)
                    const interval = setInterval(function () {
                      let now = new Date().getTime(),
                        distance = countDown - now,
                        days = Math.floor(distance / day),
                        hours = Math.floor((distance % day) / hour),
                        minutes = Math.floor((distance % hour) / minute),
                        seconds = Math.floor((distance % minute) / second);

                      (wrapper.querySelector('.js-timer-days').innerText = (
                        days
                      )),
                        (wrapper.querySelector('.js-timer-hours').innerText = (
                          hours
                        )),
                        (wrapper.querySelector('.js-timer-minutes').innerText = (
                          minutes
                        )),
                        (wrapper.querySelector('.js-timer-seconds').innerText = (
                          seconds
                        ));

                      if (distance < 0) {
                        wrapper.querySelector('.js-timer-days').innerText = '00';
                        wrapper.querySelector('.js-timer-hours').innerText = '00';
                        wrapper.querySelector('.js-timer-minutes').innerText = '00';
                        wrapper.querySelector('.js-timer-seconds').innerText = '00';
                        {% if block.settings.hide_timer_on_completed %}
                          wrapper.style.display = 'none';
                        {% endif %}
                        document.querySelector(
                          '.timer-countdown-completed-text-{{ section.id }}-{{ block.id }}'
                        ).style.display = 'block';

                        clearInterval(interval);
                      }

                    }, second);
                    document.addEventListener('shopify:section:unload', function (event) {
                      if (event.detail.sectionId === '{{ section.id }}') clearInterval(interval);
                    });
                  }
                  startTimer()
                  if (window.Shopify && Shopify.designMode) {
                    document.addEventListener('shopify:section:load', function (event) {
                      if (event.detail.sectionId === '{{ section.id }}') {
                        startTimer();
                      }
                    });
                  }
                })();
              </script>
            {% else %}

          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "🏆 Compteur elite",
  "settings": [
    {
      "type": "header",
      "content": "🏆 Application Compteur Elite",
      "info": "👉 Version de l'application Shopiweb Premium"
    },
    {
        "type": "paragraph", 
        "content": "Documentation FR : [Compteur Elite by Shopiweb](https:\/\/www.docs.shopiweb.fr\/theme-premium\/documentation\/sections\/compteur-elite)"
    },
    {
        "type": "header",
        "content": "Général"
    },
    {
        "type": "select",
        "id": "bg_type",
        "label": "Type d'arrière-plan",
        "default": "predefined",
        "options": [
            { "value": "predefined", "label": "Couleur" },
            { "value": "custom", "label": "Fondu" },
            { "value": "image", "label": "Image" }
        ]
    },
    {
        "type": "select",
        "id": "bg_color",
        "label": "Couleur d'arrière plan",
        "default": "bg-body text-body",
        "options": [
            { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
            { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
            { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
            { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
            { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
            { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
            { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
        ],
        "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé ou une image d'arrière-plan."
    },
    {
        "type": "color_background",
        "id": "bg_gradient_color",
        "label": "Dégradé personnalisé",
        "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
        "visible_if": "{{ section.settings.bg_type == 'custom' }}"
    },
    {
        "type": "image_picker",
        "id": "background_img",
        "label": "Image d'arrière-plan",
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
        "type": "range",
        "id": "background_img_opacity",
        "label": "Opacité",
        "min": 0,
        "max": 1,
        "step": 0.1,
        "default": 0.7,
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
        "type": "range",
        "id": "background_img_blur",
        "label": "Flou",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0,
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
        "type": "header",
        "content": "Mise en page"
    },
    {
        "type": "select",
        "id": "container",
        "label": "Conteneur",
        "default": "container",
        "options": [
            { "value": "container", "label": "Page" },
            { "value": "container-fluid", "label": "Personnalisé" }
        ]
    },
    {
        "type": "text",
        "id": "max_width",
        "label": "Largeur max. (px)",
        "default": "991",
        "visible_if": "{{ section.settings.container == 'container-fluid' }}"
    },
    {
        "type": "header",
        "content": "Espacement de la section"
    },
    {
        "type": "range",
        "id": "pt",
        "label": "Haut interne",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "pb",
        "label": "Bas interne",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "mt",
        "label": "Haut externe",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "mb",
        "label": "Bas externe",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "header",
        "content": "Visibilité",
        "info": "Afficher/masquer cette section en fonction de la résolution de l'écran"
    },
    {
        "type": "checkbox",
        "id": "visibility_xs",
        "label": "Afficher sur mobile",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "visibility_md",
        "label": "Afficher sur tablette",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "visibility_lg",
        "label": "Afficher sur bureau",
        "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texte",
      "limit": 1,
      "settings": [
        {
            "type": "header",
            "content": "Texte"
        },
        {
            "type": "select",
            "id": "text_align_mobile",
            "label": "Alignement du texte - mobile",
            "default": "text-center",
            "options": [
                { "value": "text-start", "label": "Gauche" },
                { "value": "text-center", "label": "Centre" },
                { "value": "text-end", "label": "Droite" }
            ]
        },
        {
            "type": "select",
            "id": "text_align_desktop",
            "label": "Alignement du texte - bureau",
            "default": "text-lg-start",
            "options": [
                { "value": "text-lg-start", "label": "Gauche" },
                { "value": "text-lg-center", "label": "Centre" },
                { "value": "text-lg-end", "label": "Droite" }
            ]
        },
        {
            "type": "image_picker",
            "id": "subtitle_img",
            "label": "Légende Image"
        },
        {
            "type": "text",
            "id": "brand_image_size",
            "label": "Image Largeur/Hauteur (px)",
            "default": "60"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Légende Texte"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "Taille de la légende",
            "default": "fs-5",
            "options": [
                { "group": "Légende Standard", "value": "fs-1", "label": "Extra Grand" },
                { "group": "Légende Standard", "value": "fs-2", "label": "Super Grand" },
                { "group": "Légende Standard", "value": "fs-3", "label": "Très Grand" },
                { "group": "Légende Standard", "value": "fs-4", "label": "Grand" },
                { "group": "Légende Standard", "value": "fs-5", "label": "Moyen" },
                { "group": "Légende Standard", "value": "fs-6", "label": "Petit" } 
            ]
        },
        {
            "type": "color",
            "id": "color_caption",
            "label": "Couleur de la légende",
            "default": "#6c757d"
        },
        {
            "type": "inline_richtext",
            "id": "title",
            "label": "Titre",
            "default": "Texte du compteur"
        },
        {
            "type": "paragraph",
            "content": "Pour ajouter une surbrillance animée à un texte, mettez-le en italique en cliquant sur le bouton 'I' dans l'éditeur."
        },
        {
            "type": "select",
            "id": "italic_color_option",
            "label": "Appliquer un style au texte en italique",
            "options": [
                { "value": "none", "label": "Aucun" },
                { "value": "apply_color", "label": "Appliquer une couleur" },
                { "value": "stencil", "label": "Appliquer le style pochoir" },
                { "value": "background_cover", "label": "Appliquer le style surbrillance" },
                { "value": "gradient_color", "label": "Appliquer une couleur dégradé" }
            ],
            "default": "none",
            "info": "Choisissez comment styliser le texte en italique : sans style supplémentaire, avec une couleur, avec un effet de pochoir ou un style de surbrillance."
        },
        {
            "type": "select",
            "id": "highlighted_text_style",
            "label": "Appliquer un style de soulignement au texte en italique",
            "options": [
                { "value": "none", "label": "Aucun" },
                { "value": "basic_underline", "label": "Soulignement Basique" },
                { "value": "squiggle_underline", "label": "Soulignement Ondulé" },
                { "value": "squiggle_underline_2", "label": "Soulignement Signature" },
                { "value": "circle_underline", "label": "Soulignement Cercle" },
                { "value": "sketch_underline", "label": "Soulignement Esquisse" },
                { "value": "heartbeat_underline", "label": "Soulignement Rythme" },
                { "value": "zigzag_underline", "label": "Soulignement Zigzag" },
                { "value": "wave_underline", "label": "Soulignement Vague" },
                { "value": "double_zigzag_underline", "label": "Soulignement Double Zigzag" }
            ],
            "default": "none",
            "info": "Choisissez un style de soulignement SVG pour le texte en surbrillance italique. Sélectionnez 'Aucun' pour ne pas appliquer de soulignement."
        },
        {
            "type": "color",
            "id": "highlight_color",
            "label": "Couleur de surbrillance",
            "default": "#25D366",
            "info": "Couleur appliquée au texte en italique et au SVG de soulignement, si activés."
        },
        {
            "type": "color_background",
            "id": "title_gradient_color",
            "label": "Dégradé de surbrillance",
            "default": "linear-gradient(90deg, #c99700 0%, #1d1d1f 100%)",
            "info": "Couleur dégradé appliquée au texte en italique, si activés et uniquement pour le style 'Appliquer une couleur dégradé'."
        },
        {
            "type": "select",
            "id": "heading_tag",
            "label": "Balise titre (SEO)",
            "default": "h2",
            "options": [
                { "value": "h1", "label": "h1" },
                { "value": "h2", "label": "h2" },
                { "value": "h3", "label": "h3" },
                { "value": "h4", "label": "h4" },
                { "value": "h5", "label": "h5" },
                { "value": "h6", "label": "h6" },
                { "value": "span", "label": "Aucune" }
            ]
        },
        {
