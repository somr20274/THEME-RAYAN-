        },
        {
            "type": "checkbox",
            "id": "visibility_xs",
            "label": "Afficher sur mobile",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_md",
            "label": "Afficher sur tablette",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_lg",
