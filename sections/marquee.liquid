                { "value": "custom", "label": "Fondu" }
            ]
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Couleur d'arrière plan",
            "default": "bg-body text-body",
            "options": [
                { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
                { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
                { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
            ],
            "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé."
        },
        {
            "type": "color_background",
            "id": "bg_gradient_color",
            "label": "Dégradé personnalisé",
            "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
            "visible_if": "{{ section.settings.bg_type == 'custom' }}"
        },
        {
            "type": "select",
            "id": "font_size",
            "label": "Taille du texte",
            "default": "fs-4",
            "options": [
                { "group": "Texte Standard", "value": "fs-1", "label": "Extra Grand" },
                { "group": "Texte Standard", "value": "fs-2", "label": "Super Grand" },
                { "group": "Texte Standard", "value": "fs-3", "label": "Très Grand" },
                { "group": "Texte Standard", "value": "fs-4", "label": "Grand" },
                { "group": "Texte Standard", "value": "fs-5", "label": "Moyen" },
                { "group": "Texte Standard", "value": "fs-6", "label": "Petit" } 
            ]
        },
        {
            "type": "select",
            "id": "text_transform",
            "label": "Transformation de texte",
            "default": "text-capitalize",
            "options": [
                { "value": "", "label": "Normal" },
                { "value": "text-capitalize", "label": "Capitale" },
                { "value": "text-lowercase", "label": "Minuscule" },
                { "value": "text-uppercase", "label": "Majuscule" }

            ]
        },
        {
            "type": "text",
            "id": "list_label",
            "label": "Libellé de la liste",
            "default": "Caractéristiques promotionnelles",
            "info": "Utilisé à des fins d'accessibilité"
        },
        {
            "type": "header",
            "content": "Effect"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Vitesse",
            "min": 0,
            "max": 60,
            "step": 1,
            "default": 20,
            "unit": "sec",
            "info": "Vitesse de défilement automatique"
        },
        {
            "type": "select",
            "id": "marquee_direction",
            "label": "Sens de défilement",
            "default": "left",
            "info": "Sens de défilement automatique",
            "options": [
                { "value": "left", "label": "Gauche" },
                { "value": "right", "label": "Droite" }

            ]
        },
        {
            "type": "select",
            "id": "separator",
            "label": "Séparateur",
            "default": "separator-dot",
            "options": [
                { "value": "", "label": "Aucun" },
                { "value": "separator-dot", "label": "Point" }

            ]
        },
        {
