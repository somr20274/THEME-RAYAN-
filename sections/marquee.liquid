        },
        {
            "type": "range",
            "id": "gap",
            "label": "Espacement",
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 6
        },
        {
            "type": "header",
            "content": "Espacement de la section"
        },
        {
            "type": "range",
            "id": "pt",
            "label": "Haut interne",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
