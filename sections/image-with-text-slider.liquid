{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    assign btn_shadow_sp = settings.btn_shadow_sp

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

{% style %}
  {% for block in section.blocks %}
    /* Readmore Shopiweb */
    #image-with-text-slider-wrapper-{{ section.id }} .limited-readmore-{{ block.id }} .bottom-readmore {
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0), {{ block.settings.readmore_color }});
    }
    #image-with-text-slider-wrapper-{{ section.id }} .read-more-checker-{{ block.id }} ~ .read-more-button-{{ block.id }}:before {
      content: "{{ block.settings.text_voirplus }}";
    }
    #image-with-text-slider-wrapper-{{ section.id }} .read-more-checker-{{ block.id }}:checked ~ .read-more-button-{{ block.id }}:before {
      content: "{{ block.settings.text_voirmoins }}";
    }
  {% endfor %}
{% endstyle %}

<section 
    id="image-with-text-slider-wrapper-{{ section.id }}" 
    class="image-with-text-slider-wrapper enter-view {{ bg_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"

    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}
  
    <div class="{{ section.settings.container }} position-relative z-1"
        {% if section.settings.container == 'container-fluid' %}
           style="max-width: {{ section.settings.max_width }}px;"
        {% endif %}>
        <div 
            id="image-with-text-slider-{{ section.id }}" 
            class="
                image-with-text-slider 
                carousel 
                {{ section.settings.animation }}
                {% if section.settings.indicators and section.blocks.size > 1 %}
                    has-indicators
                {% endif %}
            " 
            data-bs-ride="{% if section.settings.autoplay %}carousel{% else %}false{% endif %}">
            {% if section.settings.indicators and section.blocks.size > 1 %}
                <div class="carousel-indicators z-index-3 {% if section.settings.img_align_desktop == 'flex-md-row' %}align-indicators-left{% endif %}">
                    {% for block in section.blocks %}
                        <button 
                            type="button" 
                            data-bs-target="#image-with-text-slider-{{ section.id }}" 
                            data-bs-slide-to="{{ forloop.index0 }}" 
                            class="{% if forloop.first == true %}active{% endif %} {{ block.settings.shadow_sp }}" 
                            aria-current="{% if forloop.first == true %}true{% endif %}">
                            <img 
                                class="img-fluid rounded"
                                src="{{ block.settings.image | image_url: width: '160', height: '160', crop: 'center' }}"
                                alt="{{ block.settings.image.alt | escape }}"
                                width="160"
                                height="160"
                                loading="lazy">
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="carousel-inner">
                {% for block in section.blocks %}
                    <div 
                        class="carousel-item {% if forloop.first == true %}active{% endif %}" 
                        data-index="{{ forloop.index0 }}" 
                        {{ block.shopify_attributes }}>
                        <div 
                            class="row {{ section.settings.img_align_desktop }} align-items-center py-8 px-4 p-lg-12">
                            <div class="mb-8 mb-lg-0 {% if section.settings.desktop_image_width == 'small' %}col-lg-4{% elsif section.settings.desktop_image_width == 'large' %}col-lg-8{% else %}col-lg-6{% endif %}">
                                {% if block.settings.image == blank %}
                                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg rounded' }}
                                {% else %}
                                    {% liquid 
                                        case block.settings.img_orientation
                                            when 'square'
                                                assign img_width  = 900
                                                assign img_height = 900
                                            when 'landscape'
                                                assign img_width  = 900
                                                assign img_height = 720
                                            when 'landscape-x2'
                                                assign img_width  = 900
                                                assign img_height = 600
                                            when 'portrait'
                                                assign img_width  = 720
                                                assign img_height = 900
                                            when 'portrait-x2'
                                                assign img_width  = 600
                                                assign img_height = 900
                                        endcase

                                        assign classes = ''
                                        assign classes = classes | append: block.settings.img_style | append: ' ' 
                                        assign classes = classes | append: block.settings.border | append: ' '
                                        assign classes = classes | append: block.settings.border_color | append: ' ' 
                                        assign classes = classes | append: 'border-' | append: block.settings.border_width | append: ' ' 
                                        assign classes = classes | append: block.settings.shadow_sp | append: ' ' 
                                        assign classes = classes | strip
                                    %}
                                    <div class="advanced-image-in position-relative">
                                        <div class="svg-background">
                                              {% if block.settings.show_background_img_advanced %}
                                                  {% render 'svg-image-advanced', 
                                                      svg_image_name: block.settings.img_advanced_style, 
                                                      svg_image_advanced_bg_color: block.settings.svg_image_advanced_bg_color, 
                                                      svg_image_advanced_color1: block.settings.svg_image_advanced_color1, 
                                                      svg_image_advanced_color2: block.settings.svg_image_advanced_color2,
                                                      block_id: block.id
                                                  %}
                                              {% endif %}
                                        </div>
                                        <div class="advanced-image-wrap">
                                            {% if block.settings.show_background_img_advanced %}
                                                {% assign img_width = 900 %}
                                                {% assign img_height = 900 %}
                                            {% endif %}
                                            <img
                                                class="w-100 h-auto {% unless block.settings.show_background_img_advanced %}{{ classes }}{% endunless %}"
                                                src="{{ block.settings.image.src | image_url: width: img_width, height: img_height, crop: block.settings.img_crop }}"
                                                alt="{{ block.settings.image.alt | escape }}"
                                                width="{{ img_width }}"
                                                height="{{ img_height }}"
                                                loading="lazy">
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-lg-6 {{ block.settings.text_align_mobile }} {{ block.settings.text_align_desktop }} {% if section.settings.desktop_image_width == 'small' %}col-lg-8{% elsif section.settings.desktop_image_width == 'large' %}col-lg-4{% else %}col-lg-6{% endif %}">
                              {% unless block.settings.subtitle_img == blank %}
                                  <div 
                                      class="animate__animated animate__faster opacity-0"
                                      {% if settings.effect_apply_caption_enable %}
                                        data-animate-class="{{ settings.animation_caption_name }}"
                                        style="animation-delay: 1200ms;"
                                      {% endif %}>
                                          {% liquid 
                                              assign brand_img_width = block.settings.brand_image_size
                                          %}
                                          <img
                                              class="img-fluid mb-5"
                                              src="{{ block.settings.subtitle_img.src | image_url: width: brand_img_width }}"
                                              alt="{{ block.settings.subtitle_img.alt | escape }}"
                                              width="{{ brand_img_width }}"
                                              height="auto"
                                              loading="lazy">
                                      </div>
                              {% endunless %}
              
                              {% unless block.settings.subtitle == blank %}
                                  <div 
                                      class="animate__animated animate__faster opacity-0"
                                      {% if settings.effect_apply_caption_enable %}
                                        data-animate-class="{{ settings.animation_caption_name }}"
                                        style="animation-delay: 1000ms;"
                                      {% endif %}>
                                      <p class="subtitle text-uppercase fw-500 mb-3 {{ block.settings.subtitle_size }}"
                                          style="color:{{ block.settings.color_caption }};">
                                          {{ block.settings.subtitle }}
                                      </p>
                                  </div>
                              {% endunless %} 

                              {% unless block.settings.subtitle_badge1 == blank and block.settings.subtitle_badge2 == blank %}
                                  <div 
                                      class="animate__animated animate__faster opacity-0"
                                      {% if settings.effect_apply_caption_enable %}
                                        data-animate-class="{{ settings.animation_caption_name }}"
                                        style="animation-delay: 1000ms;"
                                      {% endif %}>
                                      <div class="badge-group mb-5">
                                          {% unless block.settings.subtitle_badge1 == blank %}
                                              <span class="badge d-inline-block me-2 {{ block.settings.subtitle_badge_size }} {{ block.settings.color_subtitle_badge1 }}"
                                                    style="box-shadow: #000 0 3px 10px -5px;">
                                                  {{ block.settings.subtitle_badge1 }}
                                              </span>
                                          {% endunless %}
                                          {% unless block.settings.subtitle_badge2 == blank %}
                                              <span class="badge d-inline-block me-2 {{ block.settings.subtitle_badge_size }} {{ block.settings.color_subtitle_badge2 }}"
                                                    style="box-shadow: #000 0 3px 10px -5px;">
                                                  {{ block.settings.subtitle_badge2 }}
                                              </span>
                                          {% endunless %}
                                      </div>
                                  </div>
                              {% endunless %}

                              {% unless block.settings.title == blank %}
                                  <div class="overlay-text-container my-4" style="position: relative;">
                                      <{{ block.settings.heading_tag }} class="title enter-view {{ block.settings.title_size }} animate__animated animate__faster opacity-0
                                          {% if block.settings.highlighted_text_style != 'none' %}
                                              mb-7
                                          {% else %}
                                              mb-5
                                          {% endif %}"
                                          {% if settings.effect_apply_title_enable %}
                                            data-animate-class="{{ settings.animation_title_name }}"
                                            style="animation-delay: 200ms;"
                                          {% endif %}>
                              
                                          {% assign highlighted_title = block.settings.title %}
                                          {% assign svg_parts = highlighted_title | split: '<em>' %}
                                          {% for part in svg_parts %}
                                              {% if forloop.index == 1 %}
                                                  {{ part }}
                                              {% elsif forloop.index == 2 %}
                                                  {% assign end_svg = part | split: '</em>' %}
                                                  {% if block.settings.italic_color_option == 'none' and block.settings.highlighted_text_style == 'none' %}
                                                      <em>{{ end_svg[0] }}</em>
                                                  {% else %}
                                                      &nbsp;<span class="background-animate" style="position: relative; display: inline-block;
                                                          {% if block.settings.italic_color_option == 'apply_color' and block.settings.highlight_color != blank %}
                                                              color: {{ block.settings.highlight_color }};
                                                          {% elsif block.settings.italic_color_option == 'stencil' %}
                                                              -webkit-text-stroke: .02em currentColor;
                                                              -webkit-text-fill-color: transparent;
                                                          {% elsif block.settings.italic_color_option == 'background_cover' %}
                                                              background-repeat: no-repeat;
                                                              background-image: linear-gradient(to right, {{ block.settings.highlight_color }} 0%, transparent 100%), 
                                                                                linear-gradient(to right, {{ block.settings.highlight_color }} 0%, transparent 100%);
                                                              background-position: left 70%;
                                                          {% elsif block.settings.italic_color_option == 'gradient_color' %}
                                                              -webkit-background-clip: text;
                                                              -webkit-text-fill-color: transparent;
                                                              background-repeat: no-repeat;
                                                              background-image: {{ block.settings.title_gradient_color }};
                                                              background-position: left 85%;
                                                          {% endif %}">
                                                          {{ end_svg[0] }}
                                                          {% if block.settings.highlighted_text_style != 'none' and block.settings.highlight_color != blank %}
                                                              {% render 'svg-title', svg_name: block.settings.highlighted_text_style, stroke_color: block.settings.highlight_color %}
                                                          {% endif %}
                                                      </span>&nbsp;
                                                  {% endif %}
                                                  {{ end_svg[1] }}
                                              {% else %}
                                                  {{ part }}
                                              {% endif %}
                                          {% endfor %}
                                      
                                          {% if block.settings.show_svg_h2 %}
                                              {% if settings.custom_svg_h2 != blank %}
                                                  <div class="h2_svg animate__animated animate__faster opacity-0"
                                                      {% if settings.effect_apply_svg_enable %} 
                                                        data-animate-class="{{ settings.animation_svg_name }}"
                                                        style="animation-delay: 400ms;"
                                                      {% endif %}
                                                  >
                                                      <span style="fill:{{ settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {{ settings.custom_svg_h2 }}</span>
                                                  </div>
                                              {% else %}
                                                  {% if settings.svg_h2 != 'none' %}
                                                      <div class="h2_svg mb-4 animate__animated animate__faster opacity-0"
                                                          {% if settings.effect_apply_svg_enable %} 
                                                            data-animate-class="{{ settings.animation_svg_name }}"
                                                            style="animation-delay: 400ms;"
                                                          {% endif %}
                                                      >
                                                          <span style="fill:{{ settings.color_svg_h2 }}; width:{{ settings.width_svg_h2 }}rem;"> {% render 'svg-subtitle', svg_h2: settings.svg_h2 %}</span>
                                                      </div>
                                                  {% endif %}
                                              {% endif %}
                                          {% endif %}
                                      </{{ block.settings.heading_tag }}>
                                  </div>
                              {% endunless %}

                              {% if block.settings.readmore %}
                                  <div class="holder-readmore">
                                      <input type="checkbox" class="read-more-checker read-more-checker-{{ block.id }}" id="read-more-checker--{{ block.id }}" />
                                      <div class="limited-readmore limited-readmore-{{ block.id }} l-{{ block.settings.formread }} mb-4">
                                          {% unless block.settings.description == blank %}
                                              <div 
                                                  class="animate__animated animate__faster opacity-0"
                                                  {% if settings.effect_apply_description_enable %} 
                                                    data-animate-class="{{ settings.animation_description_name }}"
                                                    style="animation-delay: 600ms;"
                                                  {% endif %}>
                                                  <div class="description rte mb-7 {{ block.settings.description_size }}">
                                                      {{ block.settings.description }}
                                                  </div>
                                              </div>
                                          {% endunless %}
                                      <div class="bottom-readmore">&nbsp</div>
                                      </div>
                                      <label for="read-more-checker--{{ block.id }}" class="read-more-button read-more-button-{{ block.id }} mb-6 animate__animated animate__faster opacity-0"
                                              {% if settings.effect_apply_description_enable %} 
                                                data-animate-class="{{ settings.animation_description_name }}"
                                                style="animation-delay: 600ms;"
                                              {% endif %}></label>
                                  </div>
                              {% else %}
                                  {% unless block.settings.description == blank %}
                                      <div 
                                          class="animate__animated animate__faster opacity-0"
                                          {% if settings.effect_apply_description_enable %} 
                                            data-animate-class="{{ settings.animation_description_name }}"
                                            style="animation-delay: 600ms;"
                                          {% endif %}>
                                          <div class="description rte mb-7 {{ block.settings.description_size }}">
                                              {{ block.settings.description }}
                                          </div>
                                      </div>
                                  {% endunless %}
                              {% endif %}
                              {% unless block.settings.btn_text == blank %}
                                  <div 
                                      class="d-inline-flex animate__animated animate__faster opacity-0"
                                      {% if settings.effect_apply_btn_enable %} 
                                        data-animate-class="{{ settings.animation_btn_name }}"
                                        style="animation-delay: 800ms;"
                                      {% endif %}>
                                      <a 
                                          class="btn {{ block.settings.btn_color }} {{ btn_shadow_sp }} {{ block.settings.btn_size }}" 
                                          href="{{ block.settings.btn_url }}">
                                          {{ block.settings.btn_text }}
                                      </a>
                                  </div>
                              {% endunless %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Image texte slider",
    "settings": [
        {
            "type": "paragraph", 
            "content": "Documentation FR : [Image Texte Slider by Shopiweb](https:\/\/www.docs.shopiweb.fr\/theme-premium\/documentation\/sections\/image-texte-slider)"
        },
        {
            "type": "header",
            "content": "Général"
        },
        {
            "type": "select",
            "id": "bg_type",
            "label": "Type d'arrière-plan",
            "default": "predefined",
            "options": [
                { "value": "predefined", "label": "Couleur" },
                { "value": "custom", "label": "Fondu" },
                { "value": "image", "label": "Image" }
            ]
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Couleur d'arrière plan",
            "default": "bg-body text-body",
            "options": [
                { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
                { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
                { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
            ],
            "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé ou une image d'arrière-plan."
        },
        {
            "type": "color_background",
            "id": "bg_gradient_color",
            "label": "Dégradé personnalisé",
            "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
            "visible_if": "{{ section.settings.bg_type == 'custom' }}"
        },
        {
            "type": "image_picker",
            "id": "background_img",
            "label": "Image d'arrière-plan",
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_opacity",
            "label": "Opacité",
            "min": 0,
            "max": 1,
            "step": 0.1,
            "default": 0.3,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_blur",
            "label": "Flou",
            "min": 0,
            "max": 10,
            "step": 1,
            "default": 0,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "header",
            "content": "Mise en page"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Conteneur",
            "default": "container",
            "options": [
                { "value": "container", "label": "Page" },
                { "value": "container-fluid", "label": "Personnalisé" }
            ]
        },
        {
            "type": "text",
            "id": "max_width",
            "label": "Largeur max. (px)",
            "default": "991",
            "visible_if": "{{ section.settings.container == 'container-fluid' }}"
        },
        {
            "type": "select",
            "id": "img_align_desktop",
            "label": "Alignement de l'image (bureau)",
            "default": "flex-md-row",
            "options": [
                { "value": "flex-md-row", "label": "Gauche" },
                { "value": "flex-md-row-reverse", "label": "Droite" }
            ]
        },
        {
            "type": "select",
            "id": "desktop_image_width",
            "label": "Largeur d'image sur ordinateur",
            "info": "L'image est automatiquement optimisée pour les mobiles.",
            "default": "medium",
            "options": [
                { "value": "small", "label": "25%" },
                { "value": "medium", "label": "50%" },
                { "value": "large", "label": "75%" }
            ]
        },
        {
            "type": "header",
            "content": "Carrousel"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Activer autoplay",
            "info": "Rotation automatique des diapositives toutes les 5 secondes",
            "default": false
        },
        {
            "type": "select",
            "id": "animation",
            "label": "Animation",
            "options": [
                { "value": "slide", "label": "Slide" },
                { "value": "slide carousel-fade", "label": "Fade" }
            ],
            "default": "slide"
        },
        {
            "type": "checkbox",
            "id": "indicators",
            "label": "Afficher les indicateurs",
            "info": "Indicateurs image",
            "default": true
        },
        {
            "type": "header",
            "content": "Espacement de la section"
        },
        {
            "type": "range",
            "id": "pt",
            "label": "Haut interne",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "pb",
            "label": "Bas interne",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "mt",
            "label": "Haut externe",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "mb",
            "label": "Bas externe",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "header",
            "content": "Visibilité",
            "info": "Afficher/masquer cette section en fonction de la résolution de l'écran"
        },
        {
            "type": "checkbox",
            "id": "visibility_xs",
            "label": "Afficher sur mobile",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_md",
            "label": "Afficher sur tablette",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_lg",
            "label": "Afficher sur bureau",
            "default": true
        }
    ],
    "blocks": [
        {
            "type": "slide",
            "name": "Slide",
            "settings": [
                {
                    "type": "header",
                    "content": "Image"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "select",
                    "id": "img_orientation",
                    "label": "Image orientation",
                    "default": "landscape",
                    "options": [
                        { "value": "square", "label": "Carré" },
                        { "value": "landscape", "label": "Paysage" },
                        { "value": "landscape-x2", "label": "Paysage 2x" },
                        { "value": "portrait", "label": "Portrait" },
                        { "value": "portrait-x2", "label": "Portrait 2x" }
                    ]
                },
                {
                    "type": "select",
                    "id": "img_crop",
                    "label": "Recadrage de l'image",
                    "default": "center",
                    "options": [
                        { "value": "top", "label": "Haut" },
                        { "value": "center", "label": "Centre" },
                        { "value": "bottom", "label": "Bas" },
                        { "value": "left", "label": "Gauche" },
                        { "value": "right", "label": "Droite" }
                    ]
                },
                {
                    "type": "select",
                    "id": "img_style",
                    "label": "Style d'angle",
