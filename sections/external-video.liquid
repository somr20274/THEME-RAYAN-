{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    else
        assign bg_class = section.settings.bg_color
    endif

    if section.settings.external_video.type == 'youtube'
        assign video_src = 'https://www.youtube.com/embed/' | append: section.settings.external_video.id | append: '&mute=1 to &autoplay=1'
    else
        assign video_src = 'https://player.vimeo.com/video/' | append: section.settings.external_video.id
    endif

    assign classes = ''
    assign classes = classes | append: section.settings.img_style | append: ' ' 
    assign classes = classes | append: section.settings.border | append: ' '
    assign classes = classes | append: section.settings.border_color | append: ' ' 
    assign classes = classes | append: 'border-' | append: section.settings.border_width | append: ' ' 
    assign classes = classes | append: section.settings.shadow_sp | append: ' ' 
    assign classes = classes | strip

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<section 
    id="external-video-{{ section.id }}" 
    class="external-video {{ bg_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"

    {% if section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>
  
    <div class="{{ section.settings.container }}">
        <div class="mx-auto" 
            {% if section.settings.container == 'container-fluid' %}
                style="max-width: {{ section.settings.max_width }}px;"
            {% endif %}>
            <div class="ratio ratio-16x9">
                <iframe
                    class="{{ classes }}"
                    src="{{ video_src }}"
                    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
                    frameborder="0"
                    allowfullscreen
                    loading="lazy"
                    {% if section.settings.force_lazyload and section.settings.external_video.type == 'youtube' %}
                        srcdoc="
                            <style>
                                * { padding:0; margin:0; overflow:hidden }
                                html, body { height: 100%; background: black; }
                                img, span { position: absolute; width: 100%; top: 0; bottom: 0; left: 0; right: 0; margin: auto; transition: all .2s ease-out; }
                                a:hover img { opacity: .75; }
                                span {
                                    width: 60px; 
                                    height: 42px;
                                    background-color: #FF0000; 
                                    color: white; 
                                    border-radius: 6px; 
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                }
                                a:hover span { transform: scale(1.1); }
                            </style>
                            <a href=https://www.youtube.com/embed/{{ section.settings.external_video.id }}?autoplay=1&mute=1>
                                <img 
                                    src=https://img.youtube.com/vi/{{ section.settings.external_video.id }}/maxresdefault.jpg 
                                    alt='Video The Dark Knight Rises: What Went Wrong? – Wisecrack Edition'>
                                <span>
                                    <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' fill='currentColor' class='bi bi-play-fill' viewBox='0 0 16 16'>
                                        <path d='m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z'/>
                                    </svg>
                                </span>
                            </a>"
                    {% endif %}>
                </iframe>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Video externe",
    "settings": [
        {
            "type": "paragraph", 
            "content": "Documentation FR : [Video Externe by Shopiweb](https:\/\/www.docs.shopiweb.fr\/theme-premium\/documentation\/sections\/video-externe)"
        },
        {
            "type": "header",
            "content": "Général"
        },
        {
            "type": "select",
            "id": "bg_type",
            "label": "Type d'arrière-plan",
            "default": "predefined",
            "options": [
                { "value": "predefined", "label": "Couleur" },
                { "value": "custom", "label": "Fondu" }
            ]
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Couleur d'arrière plan",
            "default": "bg-body text-body",
            "options": [
                { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
                { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
                { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
            ],
            "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé."
        },
        {
            "type": "color_background",
            "id": "bg_gradient_color",
            "label": "Dégradé personnalisé",
            "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
            "visible_if": "{{ section.settings.bg_type == 'custom' }}"
        },
        {
            "type": "video_url",
            "id": "external_video",
            "label": "Lien de la video",
            "accept": [
                "youtube", "vimeo"
            ],
            "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
        },
        {
            "type": "header",
            "content": "Mise en page"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Conteneur",
            "default": "container",
            "options": [
                { "value": "container", "label": "Page" },
                { "value": "container-fluid", "label": "Personnalisé" }
            ]
        },
        {
            "type": "text",
            "id": "max_width",
            "label": "Largeur max. (px)",
            "default": "991",
            "visible_if": "{{ section.settings.container == 'container-fluid' }}"
        },
        {
            "type": "select",
            "id": "img_style",
            "label": "Style d'angle",
            "options": [
              { "value": "rounded-0", "label": "Pas d'arrondi" },
              { "value": "rounded", "label": "Image arrondi complet" },
              { "value": "rounded-top", "label": "Image arrondi en haut" },
              { "value": "rounded-bottom", "label": "Image arrondi en bas" },
              { "value": "rounded-start", "label": "Image arrondi à gauche" },
              { "value": "rounded-end", "label": "Image arrondi à droite" }
            ],
            "default": "rounded"
        },
        {
            "type": "select",
            "id": "border",
            "label": "Bordure de l'image",
            "default": "border",
            "options": [
                { "value": "", "label": "Aucune" },
                { "value": "border", "label": "Bordure" }
            ]
        },
        {
            "type": "select",
            "id": "border_color",
            "label": "Couleur de la bordure",
            "options": [
                { "value": "", "label": "Default" },
                { "value": "border-primary", "label": "Primaire" },
                { "value": "border-secondary", "label": "Secondaire" },
                { "value": "border-tertiary", "label": "Tertiaire" },
                { "value": "border-dark", "label": "Sombre" },
                { "value": "border-success", "label": "Succès" },
                { "value": "border-warning", "label": "Avertissement" },
                { "value": "border-danger", "label": "Danger" },
                { "value": "border-info", "label": "Info" }
            ],
            "default": "",
            "visible_if": "{{ section.settings.border == 'border' }}"
        },
        {
            "type": "range",
            "id": "border_width",
            "label": "Largeur de la bordure",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 1,
            "visible_if": "{{ section.settings.border == 'border' }}"
        },
        {
            "type": "select",
            "id": "shadow_sp",
            "label": "Ombre",
            "options": [
                { "value": "shadow-none", "label": "Aucune" },
                { "value": "shadow-1", "label": "Ombre légère" },
                { "value": "shadow-2", "label": "Ombre partiel" },
                { "value": "shadow-3", "label": "Ombre profonde" },
                { "value": "shadow-4", "label": "Ombre totale" }
            ],
            "default": "shadow-1"
        },
        {
            "type": "checkbox",
            "id": "force_lazyload",
            "label": "Forcer le Lazyload",
            "info": "Remarque: S'applique uniquement aux vidéos YouTube. Les navigateurs modernes prennent en charge la fonction native de chargement paresseux, mais lorsque ce paramètre est activé, les iframes de YouTube bénéficient d'une meilleure implémentation du chargement paresseux, car seule la capture d'écran de la vidéo est chargée.",
            "default": true
        },
        {
            "type": "header",
            "content": "Espacement de la section"
        },
        {
            "type": "range",
            "id": "pt",
            "label": "Haut interne",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "pb",
            "label": "Bas interne",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "mt",
            "label": "Haut externe",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "mb",
            "label": "Bas externe",
            "min": 0,
            "max": 20,
            "step": 1,
            "default": 0
        },
        {
            "type": "header",
            "content": "Visibilité",
            "info": "Afficher/masquer cette section en fonction de la résolution de l'écran"
        },
        {
            "type": "checkbox",
            "id": "visibility_xs",
            "label": "Afficher sur mobile",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_md",
            "label": "Afficher sur tablette",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "visibility_lg",
            "label": "Afficher sur bureau",
            "default": true
        }
    ],
    "presets": [
        {
            "name": "Vidéo externe",
            "category": "Média & Interaction"
        }
    ]
}
{% endschema %}
