{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    assign btn_shadow_sp = settings.btn_shadow_sp

    assign row_xs = section.settings.breakpoint_xs | prepend: 'row-cols-'
    assign row_sm = section.settings.breakpoint_sm | prepend: 'row-cols-sm-'
    assign row_md = section.settings.breakpoint_md | prepend: 'row-cols-md-'
    assign row_lg = section.settings.breakpoint_lg | prepend: 'row-cols-lg-'
    assign row_xl = section.settings.breakpoint_xl | prepend: 'row-cols-xl-'
    assign row_xxl = section.settings.breakpoint_xxl | prepend: 'row-cols-xxl-'

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<section
    id="animated-counters-{{ section.id }}" 
    class="animated-counters enter-view {{ bg_class }} {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"
  
    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}
  
    <div class="{{ section.settings.container }} position-relative" 
        {% if section.settings.container == 'container-fluid' %}
           style="max-width: {{ section.settings.max_width }}px;"
        {% endif %}>
        {% render 'section-header' %}
        <ul class="list-unstyled row mx-n3 mx-lg-n4 {{ row_xs }} {{ row_sm }} {{ row_md }} {{ row_lg }} {{ row_xl }} {{ row_xxl }}">
            {% for block in section.blocks %}
                <li class="p-3 p-lg-6" {{ block.shopify_attributes }}>
                    <p 
                        id="animated-counter-{{ block.id }}"
                        class="animated-counter mb-3 h3 {{ block.settings.value_size }} {{ block.settings.value_color }} {% if block.settings.show_circle %}animated-counter-circle mt-6 mb-6{% endif %}" 
                        data-value="{{ block.settings.value_number }}" 
                        data-speed="{{ section.settings.animation_speed }}"
                        data-circle-active-color="{{ block.settings.circle_active_color }}" 
                        data-circle-inactive-color="{{ block.settings.circle_inactive_color }}"
                        aria-label="{{ block.settings.value_number }}">
                        <span class="animated-counter-inner">
                            <em class="fst-normal">0</em>
                            {% unless block.settings.suffix == blank %}
                                <span class="d-inline-block ms-n2" style="font-size: .75em;">
                                    {{ block.settings.suffix }}
                                </span>
                            {% endunless %}
                        </span>
                    </p>
                    {% unless block.settings.title == blank %}
                        <h2 class="title mb-2 {{ block.settings.title_size }}">
                            {{ block.settings.title }}
                        </h2>
                    {% endunless %}
                    {% unless block.settings.description == blank %}
                        <div class="description rte mb-0 {{ block.settings.description_size }}">
                            {{ block.settings.description }}
                        </div>
                    {% endunless %}
                    {% unless block.settings.btn_text == blank %}
                        <a class="btn mt-5 {{ block.settings.btn_color }} {{ btn_shadow_sp }} {{ block.settings.btn_size }}" href="{{ block.settings.btn_url }}">
                            {{ block.settings.btn_text }}
                        </a>
                    {% endunless %}
                </li>
            {% endfor %}
        </ul>
    </div>
</section>


