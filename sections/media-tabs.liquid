{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    else
        assign bg_class = section.settings.bg_color
    endif

    assign classes = ''
    assign classes = classes | append: section.settings.img_style | append: ' ' 
    assign classes = classes | append: section.settings.border | append: ' '
    assign classes = classes | append: section.settings.border_color | append: ' ' 
    assign classes = classes | append: 'border-' | append: section.settings.border_width | append: ' ' 
    assign classes = classes | append: section.settings.shadow_sp | append: ' ' 
    assign classes = classes | strip

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<style>  
{% for block in section.blocks %}
    #media-nav-block-{{ block.id }} .nav-link {
        color: var(--bs-body-color);
        opacity: .7;
    }
    .media-navigation.text-white .nav-link {
        color: #fff !important;
    }
    .media-navigation.text-white .nav-link:hover,
    .media-navigation.text-white .nav-link:focus {
        color: var(--bs-nav-link-hover-color)!important;
    }

    .media-navigation.bg-primary.text-white .nav-link:hover {
        color: #fff !important;
        opacity: 1;
    }
    .media-navigation.text-white .nav-link:focus {
        color: #fff !important;
    }
    
    #media-nav-block-{{ block.id }} .nav-link:hover,
    #media-nav-block-{{ block.id }} .nav-link:focus {
        color: var(--bs-nav-link-hover-color);
        opacity: 1!important;
    }
    #media-nav-block-{{ block.id }} .nav-link.active {
        /*color: var(--bs-nav-pills-link-active-color)!important;*/
        color: {{ section.settings.text_pill_color }}!important;
        background-color: {{ section.settings.btn_pill_color }};
        opacity: 1;
    }
    
{% endfor %}
</style>

<section 
    id="media-navigation-{{ section.id }}" 
    class="media-navigation enter-view {{ bg_class }} {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"

    {% if section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>
  
    <div class="{{ section.settings.container }}">
        <div class="mx-auto" 
            {% if section.settings.container == 'container-fluid' %}
                style="max-width: {{ section.settings.max_width }}px;"
            {% endif %}>
            {% render 'section-header' %}
            <div class="tab-content mx-auto text-center" id="TabContentMedia">
                {% for block in section.blocks %}
                    <div class="tab-pane {% if forloop.first %}show active{% endif %} mb-6 pb-6" 
                         id="{{ block.id }}-pane" 
                         role="tabpanel" 
                         aria-labelledby="{{ block.id }}-tab" 
                         tabindex="0">
                        <div 
                            class="animate__animated animate__faster opacity-0"
                            data-animate-class="animate__fadeIn"
                            style="animation-delay: 0ms">
                            {% if block.settings.video != blank %}
                                {% assign video_class = section.settings.border | append: ' border-' | append: section.settings.border_width | append: ' ' | append: section.settings.img_style | append: ' ' | append: 'w-100' | append: ' ' | append: section.settings.shadow_sp | append: ' ' | append: section.settings.border_color %}                                
                                {{ block.settings.video | video_tag: class: video_class, image_size: '800x', autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.muted, controls: block.settings.controls }}
                            {% elsif block.settings.img != blank %}
                                <img
                                    class="img-fluid {{ classes }}"
                                    src="{{ block.settings.img.src | image_url: width: 900 }}"
                                    alt="{{ block.settings.img.alt | escape }}"
                                    width="900"
                                    height="{{ 900 | divided_by: block.settings.img.aspect_ratio | round }}"
                                    loading="lazy">
                            {% else %}
                                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg rounded' }}
                            {% endif %}
                        </div>
                        <div class="description rte mt-6 text-center text-muted mx-auto {{ block.settings.tab_description_size }}"
                             style="max-width: 500px; opacity: .8;">
                            {{ block.settings.tab_description }}
                        </div>
                    </div>
                {% endfor %}
            </div>
              
            <div class="d-lg-flex justify-content-lg-center align-items-lg-center">
                <ul class="nav nav-pills nav-fill gap-2 p-1 rounded d-flex flex-nowrap overflow-auto {{ section.settings.border_nav }} border-{{ section.settings.border_width_nav }} {{ section.settings.border_color_nav }} {{ section.settings.shadow_sp_tab }}" 
                    id="myTab" 
                    role="tablist">
                    {% for block in section.blocks %}
                        <li id="media-nav-block-{{ block.id }}" class="nav-item flex-shrink-0 small" role="presentation" {{ block.shopify_attributes }}>
                            <a class="nav-link rounded headings-font-family {% if forloop.first %}active{% endif %}" id="{{ block.id }}-tab" data-bs-toggle="tab" data-bs-target="#{{ block.id }}-pane" type="button" role="tab" aria-controls="{{ block.id }}-pane" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                                <div class="d-flex align-items-center">
                                    {% unless block.settings.icon == blank %}
                                        <div class="me-3">
                                            {{ block.settings.icon }}
                                        </div>
                                    {% endunless %}
                                {{ block.settings.tab_title }}
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

        </div>
    </div>
</section>


