{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif

    case section.settings.img_orientation
        when 'square'
            assign img_width  = 900
            assign img_height = 900
        when 'landscape'
            assign img_width  = 900
            assign img_height = 720
        when 'landscape-x2'
            assign img_width  = 900
            assign img_height = 600
        when 'portrait'
            assign img_width  = 720
            assign img_height = 900
        when 'portrait-x2'
            assign img_width  = 600
            assign img_height = 900
    endcase

    assign classes = ''
    assign classes = classes | append: section.settings.img_style | append: ' ' 
    assign classes = classes | append: section.settings.border | append: ' '
    assign classes = classes | append: section.settings.border_color | append: ' ' 
    assign classes = classes | append: 'border-' | append: section.settings.border_width | append: ' ' 
    assign classes = classes | append: section.settings.shadow_sp | append: ' ' 
    assign classes = classes | strip

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

{% if section.settings.accordion_style == 'accordion-custom' %}
    {% style %}
    #faq-{{ section.id }} .accordion-custom .accordion-button {
        background-color: {{ section.settings.accordion_custom_bg }} !important;
        color: {{ section.settings.accordion_custom_title_color }};
    }
    #faq-{{ section.id }} .accordion-custom .accordion-button:not(.collapsed) {
        background-color: {{ section.settings.accordion_custom_bg_actif }} !important;
        color: {{ section.settings.accordion_custom_title_color_actif }};
    }
    
    #faq-{{ section.id }} .accordion-custom .accordion-button::after {
        background-color: {{ section.settings.accordion_custom_bg_plus }};
        color: {{ section.settings.accordion_custom_plus_color }};
    }  
    #faq-{{ section.id }} .accordion-custom .accordion-button:not(.collapsed)::after {
        background-color: {{ section.settings.accordion_custom_bg_plus_actif }};
        color: {{ section.settings.accordion_custom_plus_color_actif }};
    } 
    {% endstyle %}
{% endif %}

<section 
    id="faq-{{ section.id }}" 
    class="faq enter-view {{ bg_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"
    
    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}
  
    <div class="{{ section.settings.container }} position-relative z-1">
        <div class="mx-auto" 
            {% if section.settings.container == 'container-fluid' %}
                style="max-width: {{ section.settings.max_width }}px;"
            {% endif %}>
            <div class="row align-items-center {{ section.settings.img_align_desktop }}">
                {% unless section.settings.image == blank %}
                    <div class="col-lg-6 mb-8 mb-lg-0">
                        <div 
                            class="animate__animated animate__faster opacity-0"
                            data-animate-class="animate__fadeIn"
                            style="animation-delay: 0ms">
                            <img
                                class="img-fluid {{ classes }}"
                                src="{{ section.settings.image.src | image_url: width: img_width, height: img_height, crop: section.settings.img_crop }}"
                                alt="{{ section.settings.image.alt | escape }}"
                                width="{{ img_width }}"
                                height="{{ img_height }}"
                                loading="lazy">
                        </div>
                    </div>
                {% endunless %}
                <div class="{% if section.settings.image == blank %}col-lg-12{% else %}col-lg-6{% endif %} {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }}">
                    {% render 'section-header' %}
                    <div {% if section.settings.accordion_style == 'accordion-flush' %} style="border-radius: unset!important;" {% endif %}
                         {% if section.settings.accordion_style == 'accordion-custom' %} style="border-radius: unset!important; box-shadow: unset!important; border: unset!important" {% endif %}
                        id="faq-accordion-{{ section.id }}" 
                        class="accordion {{ section.settings.accordion_style }} {{ section.settings.border_faq }} border-{{ section.settings.border_width_faq }} {{ section.settings.border_color_faq }} {{ section.settings.shadow_sp_faq }}"
                        style="border-radius: var(--bs-border-radius)!important;">
                        {% for block in section.blocks %}
                            <div class="accordion-item" {{ block.shopify_attributes }}>
                                <{{ block.settings.heading_tag }} 
                                    id="faq-accordion-{{ section.id }}-heading-{{ forloop.index }}" 
                                    class="accordion-header {% if section.settings.accordion_style == 'accordion-custom' %} rounded {{ section.settings.shadow_sp_faq }}{% endif %}">
                                    <button 
                                        class="accordion-button {% unless forloop.first %}collapsed{% endunless %}
                                        {% if section.settings.accordion_style == 'accordion-custom' and section.settings.border_faq == 'border' %} {{ section.settings.border_faq }} border-{{ section.settings.border_width_faq }} {{ section.settings.border_color_faq }}{% else %} border-0{% endif %}" 
                                        type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#faq-accordion-{{ section.id }}-collapse-{{ forloop.index }}" 
                                        aria-expanded="{% if forloop.first and section.settings.show_expanded %}true{% else %}false{% endif %}"
                                        aria-controls="faq-accordion-{{ section.id }}-collapse-{{ forloop.index }}">
                                        <div class="d-flex align-items-center">
                                            {% unless block.settings.icon == blank %}
                                                <div class="me-3">
                                                    {{ block.settings.icon }}
                                                </div>
                                            {% endunless %}
                                            {{ block.settings.title | escape }}
                                        </div>
                                    </button>
                                </{{ block.settings.heading_tag }}>
                                <div 
                                    id="faq-accordion-{{ section.id }}-collapse-{{ forloop.index }}" 
                                    class="accordion-collapse collapse {% if forloop.first and section.settings.show_expanded %}show{% endif %}" 
                                    aria-labelledby="faq-accordion-{{ section.id }}-heading-{{ forloop.index }}" 
                                    data-bs-parent="#faq-accordion-{{ section.id }}">
                                    <div class="accordion-body rte text-start pt-4 pb-6">
                                        <div class="row align-items-center {{ block.settings.img_align_desktop }}">
                                            {% unless block.settings.img == blank %}
                                                {% liquid
                                                    case block.settings.img_orientation
                                                        when 'square'
                                                            assign img_width  = 900
                                                            assign img_height = 900
                                                        when 'landscape'
                                                            assign img_width  = 900
                                                            assign img_height = 720
                                                        when 'landscape-x2'
                                                            assign img_width  = 900
                                                            assign img_height = 600
                                                        when 'portrait'
                                                            assign img_width  = 720
                                                            assign img_height = 900
                                                        when 'portrait-x2'
                                                            assign img_width  = 600
                                                            assign img_height = 900
                                                    endcase
                                                    assign classes = ''
                                                    assign classes = classes | append: block.settings.img_style | append: ' ' 
                                                    assign classes = classes | append: block.settings.border | append: ' '
                                                    assign classes = classes | append: block.settings.border_color | append: ' ' 
                                                    assign classes = classes | append: 'border-' | append: block.settings.border_width | append: ' ' 
                                                    assign classes = classes | append: block.settings.shadow_sp | append: ' ' 
                                                    assign classes = classes | strip
                                                %}
                                                <div class="col-lg-6 mb-6 mb-lg-0">
                                                    <img
                                                        class="img-fluid {{ classes }}"
                                                        src="{{ block.settings.img.src | image_url: width: img_width, height: img_height, crop: block.settings.img_crop }}"
                                                        alt="{{ block.settings.img.alt | escape }}"
                                                        width="{{ img_width }}"
                                                        height="{{ img_height }}"
                                                        loading="lazy">
                                                </div>
                                            {% endunless %}
                                          
                                            {% unless block.settings.video == blank %}
                                              <div class="col-lg-6 mb-6 mb-lg-0">
                                                  {% liquid
                                                    assign classes = ''
                                                    assign classes = classes | append: block.settings.img_style_video | append: ' ' 
                                                    assign classes = classes | append: block.settings.border_video | append: ' '
                                                    assign classes = classes | append: block.settings.border_color_video | append: ' ' 
                                                    assign classes = classes | append: 'border-' | append: block.settings.border_width_video | append: ' ' 
                                                    assign classes = classes | append: block.settings.shadow_sp_video | append: ' ' 
                                                    assign classes = classes | strip
                                                  %}
                                                  <div 
                                                      class="{{ classes }}">
                                                      <div class="ratio {{ block.settings.ratio }}">
                                                          {% liquid assign class = 'rounded ' %}
                                                          {{ block.settings.video | video_tag: class: class, image_size: '1200x', autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.muted, controls: block.settings.controls }}
                                                      </div>
                                                  </div>
                                              </div>
                                            {% endunless %}
                                            
                                            {% unless block.settings.external_video == blank %}
                                                {% liquid 
                                                    if block.settings.external_video.type == 'youtube'
                                                        assign video_src = 'https://www.youtube.com/embed/' | append: section.settings.external_video.id | append: '&mute=1 to &autoplay=1'
                                                    else
                                                        assign video_src = 'https://player.vimeo.com/video/' | append: section.settings.external_video.id
                                                    endif
        
                                                    assign classes = ''
                                                    assign classes = classes | append: block.settings.img_style_video | append: ' ' 
                                                    assign classes = classes | append: block.settings.border_video | append: ' '
                                                    assign classes = classes | append: block.settings.border_color_video | append: ' ' 
                                                    assign classes = classes | append: 'border-' | append: block.settings.border_width_video | append: ' ' 
                                                    assign classes = classes | append: block.settings.shadow_sp_video | append: ' ' 
                                                    assign classes = classes | strip
                                                %}
                                                <div class="col-lg-6 mb-6 mb-lg-0">
                                                    <div class="ratio ratio-16x9">
                                                        <iframe
                                                            class="{{ classes }}"
                                                            src="{{ video_src }}"
                                                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
                                                            frameborder="0"
                                                            allowfullscreen
                                                            loading="lazy"
                                                            {% if block.settings.force_lazyload and block.settings.external_video.type == 'youtube' %}
                                                                srcdoc="
                                                                    <style>
                                                                        * { padding:0; margin:0; overflow:hidden }
                                                                        html, body { height: 100%; background: black; }
                                                                        img, span { position: absolute; width: 100%; top: 0; bottom: 0; left: 0; right: 0; margin: auto; transition: all .2s ease-out; }
                                                                        a:hover img { opacity: .75; }
                                                                        span {
                                                                            width: 60px; 
                                                                            height: 42px;
                                                                            background-color: #FF0000; 
                                                                            color: white; 
                                                                            border-radius: 6px; 
                                                                            display: flex;
                                                                            align-items: center;
                                                                            justify-content: center;
                                                                        }
                                                                        a:hover span { transform: scale(1.1); }
                                                                    </style>
                                                                    <a href=https://www.youtube.com/embed/{{ block.settings.external_video.id }}?autoplay=1&mute=1>
                                                                        <img 
                                                                            src=https://img.youtube.com/vi/{{ block.settings.external_video.id }}/maxresdefault.jpg 
                                                                            alt='Video The Dark Knight Rises: What Went Wrong? – Wisecrack Edition'>
                                                                        <span>
                                                                            <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' fill='currentColor' class='bi bi-play-fill' viewBox='0 0 16 16'>
                                                                                <path d='m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z'/>
                                                                            </svg>
                                                                        </span>
                                                                    </a>"
                                                            {% endif %}>
                                                        </iframe>
                                                    </div>
                                                </div>
                                            {% endunless %}
                                            <div class="{% if block.settings.img == blank and block.settings.video == blank and block.settings.external_video == blank %}col-lg-12{% else %}col-lg-6{% endif %}">
                                                {{ block.settings.description }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
        {% for block in section.blocks %}
            {
                "@type": "Question",
                "name": {{ block.settings.title | json }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ block.settings.description | json }}
                }
            }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        ]
    }
</script>

{% schema %}
{
    "name": "F.A.Q",
    "settings": [
        {
            "type": "paragraph", 
            "content": "Documentation FR : [F.A.Q by Shopiweb](https:\/\/www.docs.shopiweb.fr\/theme-premium\/documentation\/sections\/f.a.q)"
        },
        {
            "type": "header",
            "content": "Général"
        },
        {
            "type": "select",
            "id": "bg_type",
            "label": "Type d'arrière-plan",
            "default": "predefined",
            "options": [
                { "value": "predefined", "label": "Couleur" },
                { "value": "custom", "label": "Fondu" },
                { "value": "image", "label": "Image" }
            ]
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Couleur d'arrière plan",
            "default": "bg-body text-body",
            "options": [
                { "group": "Principal", "value": "bg-primary text-white", "label": "Primaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-secondary text-white", "label": "Secondaire (Texte blanc)" },
                { "group": "Principal", "value": "bg-tertiary text-white", "label": "Tertiaire (Texte blanc)" },
                { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire (Texte noir)" },
                { "group": "Intermédiaire", "value": "bg-dark text-white", "label": "Sombre (Texte blanc)" },
                { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body) (Texte noir)" }
            ],
            "info": "S'applique également au texte si vous sélectionnez un dégradé personnalisé ou une image d'arrière-plan."
        },
        {
            "type": "color_background",
            "id": "bg_gradient_color",
            "label": "Dégradé personnalisé",
            "default": "linear-gradient(180deg, #6c757d 0%, #343a40 100%)",
            "visible_if": "{{ section.settings.bg_type == 'custom' }}"
        },
        {
            "type": "image_picker",
            "id": "background_img",
            "label": "Image d'arrière-plan",
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_opacity",
            "label": "Opacité",
            "min": 0,
            "max": 1,
            "step": 0.1,
            "default": 0.3,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "range",
            "id": "background_img_blur",
            "label": "Flou",
            "min": 0,
            "max": 10,
            "step": 1,
            "default": 0,
            "visible_if": "{{ section.settings.bg_type == 'image' }}"
        },
        {
            "type": "header",
            "content": "Mise en page"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Conteneur",
            "default": "container",
            "options": [
                { "value": "container", "label": "Page" },
                { "value": "container-fluid", "label": "Personnalisé" }
            ]
        },
        {
            "type": "text",
            "id": "max_width",
            "label": "Largeur max. (px)",
            "default": "991",
            "visible_if": "{{ section.settings.container == 'container-fluid' }}"
        },
        {
            "type": "select",
            "id": "accordion_style",
            "label": "Style rangée réductible",
            "default": "accordion-default",
            "info": "Si vous choissisez Simple (sans bordure), veuillez selectionner la couleur de la bordure sur (Default)",
            "options": [
                { "value": "accordion-default", "label": "Par défaut" },
                { "value": "accordion-flush", "label": "Sans bordure" },
                { "value": "accordion-custom", "label": "Personnalisé" }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_expanded",
            "label": "Afficher la première question développée",
            "default": true
        },
        {
            "type": "header",
            "content": "Options de Personnalisation"
        },
        {
            "type": "paragraph",
            "content": "Les options de personnalisation des couleurs sont exclusivement disponibles pour le style de rangée réductible personnalisé."
        },
        {
            "type": "color",
            "id": "accordion_custom_bg",
            "label": "Couleur de Fond (Fermé)",
            "default": "#ffffff",
            "info": "La couleur de fond lorsque la rangée réductible est fermée."
        },
        {
            "type": "color",
            "id": "accordion_custom_title_color",
            "label": "Couleur du Titre (Fermé)",
            "default": "#212529",
            "info": "La couleur du titre de la question lorsque la rangée réductible est fermée."
        },
        {
            "type": "color",
            "id": "accordion_custom_bg_plus",
            "label": "Couleur de la Pastille + (Fermé)",
            "default": "#f56900",
            "info": "La couleur de la pastille + lorsque la rangée réductible est fermée."
        },
        {
            "type": "color",
            "id": "accordion_custom_plus_color",
            "label": "Couleur du Signe + (Fermé)",
            "default": "#ffffff",
            "info": "La couleur du signe + lorsque la rangée réductible est fermée."
        },
        {
            "type": "color",
            "id": "accordion_custom_bg_actif",
            "label": "Couleur de Fond (Ouvert)",
            "default": "#f56900",
            "info": "La couleur de fond lorsque la rangée réductible est ouverte."
        },
        {
            "type": "color",
            "id": "accordion_custom_title_color_actif",
            "label": "Couleur du Titre (Ouvert)",
            "default": "#ffffff",
            "info": "La couleur du titre de la question lorsque la rangée réductible est ouverte."
        },
        {
            "type": "color",
            "id": "accordion_custom_bg_plus_actif",
            "label": "Couleur de la Pastille - (Ouvert)",
            "default": "#ffffff",
            "info": "La couleur de la pastille - lorsque la rangée réductible est ouverte."
        },
        {
            "type": "color",
            "id": "accordion_custom_plus_color_actif",
            "label": "Couleur du Signe - (Ouvert)",
            "default": "#f56900",
            "info": "La couleur du signe - lorsque la rangée réductible est ouverte."
        },
        {
            "type": "select",
            "id": "border_faq",
            "label": "Bordure de la faq",
            "default": "border",
            "options": [
                { "value": "", "label": "Aucune" },
                { "value": "border", "label": "Bordure" }
            ]
        },
        {
            "type": "select",
            "id": "border_color_faq",
            "label": "Couleur de la bordure faq",
            "options": [
                { "value": "", "label": "Par défaut" },
                { "value": "border-primary", "label": "Primaire" },
                { "value": "border-secondary", "label": "Secondaire" },
                { "value": "border-tertiary", "label": "Tertiaire" },
                { "value": "border-dark", "label": "Sombre" },
                { "value": "border-success", "label": "Succès" },
                { "value": "border-warning", "label": "Avertissement" },
                { "value": "border-danger", "label": "Danger" },
                { "value": "border-info", "label": "Info" }
            ],
            "default": "",
            "visible_if": "{{ section.settings.border_faq == 'border' }}"
        },
        {
            "type": "range",
            "id": "border_width_faq",
            "label": "Largeur de la bordure faq",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 1,
            "visible_if": "{{ section.settings.border_faq == 'border' }}"
        },
        {
            "type": "select",
            "id": "shadow_sp_faq",
            "label": "Ombre",
            "options": [
                { "value": "shadow-none", "label": "Aucune" },
                { "value": "shadow-1", "label": "Ombre légère" },
                { "value": "shadow-2", "label": "Ombre partiel" },
                { "value": "shadow-3", "label": "Ombre profonde" },
                { "value": "shadow-4", "label": "Ombre totale" }
            ],
            "default": "shadow-1"
        },
        {
            "type": "header",
            "content": "En-tête de la section"
        },
        {
            "type": "select",
            "id": "text_align_mobile",
            "label": "Alignement du texte - mobile",
            "default": "text-center",
            "options": [
                { "value": "text-start", "label": "Gauche" },
                { "value": "text-center", "label": "Centre" },
                { "value": "text-end", "label": "Droite" }
            ]
        },
        {
            "type": "select",
            "id": "text_align_desktop",
            "label": "Alignement du texte - bureau",
            "default": "text-lg-center",
            "options": [
                { "value": "text-lg-start", "label": "Gauche" },
                { "value": "text-lg-center", "label": "Centre" },
                { "value": "text-lg-end", "label": "Droite" }
            ]
        },
        {
            "type": "image_picker",
            "id": "subtitle_img",
            "label": "Légende Image"
        },
        {
            "type": "text",
            "id": "brand_image_size",
            "label": "Image Largeur/Hauteur (px)",
            "default": "60"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Légende Texte"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "Taille de la légende",
