{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'
  
    assign bg_color = section.settings.bg_color
  
    if section.settings.bg_gradient
      assign bg_color = bg_color | append: ' bg-gradient'
    endif
  
    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<section 
  id="breadcrumbs-wrapper-{{ section.id }}" 
  class="breadcrumbs-wrapper {{ bg_color }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}">
  <div class="{{ section.settings.container }}">
    {% render 'breadcrumbs' %}
  </div>
</section>

{% schema %}
{
  "name": "Fil d'ariane",
  "settings": [
    {
        "type": "select",
        "id": "bg_color",
        "label": "Couleur de l'arrière plan",
        "default": "bg-body text-body",
        "options": [
            { "group": "Intermédiaire", "value": "bg-white text-dark", "label": "Blanc" },
            { "group": "Intermédiaire", "value": "bg-light text-body", "label": "Claire" },
            { "group": "Par défaut", "value": "bg-body text-body", "label": "Corps (body)" }
        ]
    },
    {
        "type": "select",
        "id": "container",
        "label": "Conteneur",
        "default": "container",
        "options": [
            { "value": "container", "label": "Page" },
            { "value": "container-fluid", "label": "Complet" }
        ]
    },
    {
        "type": "header",
        "content": "Espacement de la section"
    },
    {
        "type": "range",
        "id": "pt",
        "label": "Haut interne",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "pb",
        "label": "Bas interne",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "mt",
        "label": "Haut externe",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "range",
        "id": "mb",
        "label": "Bas externe",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0
    },
    {
        "type": "header",
        "content": "Visibilité",
        "info": "Afficher/masquer cette section en fonction de la résolution de l'écran"
    },
    {
        "type": "checkbox",
        "id": "visibility_xs",
        "label": "Afficher sur mobile",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "visibility_md",
        "label": "Afficher sur tablette",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "visibility_lg",
        "label": "Afficher sur bureau",
        "default": true
    }
  ],
  "presets": [
    {
      "name": "Fil d'ariane",
      "category": "Engagement"
    }
  ]
}
{% endschema %}