{% liquid 
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'
    assign mt = section.settings.mt | prepend: 'mt-'
    assign mb = section.settings.mb | prepend: 'mb-'

    if section.settings.bg_type == 'custom'
        assign text_color_class = section.settings.bg_color | split: " " | last
        assign bg_class = 'content-bg-gradient ' | append: text_color_class
    elsif section.settings.bg_type == 'image'
        assign bg_class = section.settings.bg_color | split: " " | last
    else
        assign bg_class = section.settings.bg_color
    endif
  
    assign btn_shadow_sp = settings.btn_shadow_sp

    assign visibility = ''

    if section.settings.visibility_xs == false
        assign visibility = 'd-none'
    endif

    if section.settings.visibility_md
        assign visibility = ' d-md-block' | prepend: visibility
    else 
        assign visibility = ' d-md-none' | prepend: visibility
    endif

    if section.settings.visibility_lg
        assign visibility = ' d-lg-block' | prepend: visibility
    else 
        assign visibility = ' d-lg-none' | prepend: visibility
    endif
%}

<style>
  .discount-spot-tiers {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0;
  }
  
  .discount-spot-tiers li {
      flex: 1;
      text-align: center;
      margin: .125rem;
  }
  
  .discount-spot-tiers li span, .discount-spot-tiers li b {
      display: block;
      padding: .25rem;
  }
  
  .discount-spot-tiers li b {
      font-size: 3rem;
      line-height: 0.9;
  }
  @media (max-width: 575px) {
      .discount-spot-tiers {
          flex-wrap: wrap;
          max-width: 340px;
          margin-left: auto !important;
          margin-right: auto !important;
      }
      .discount-spot-tiers li {
          width: 48%;
          margin: .5rem;
      }
  }
</style>

{% if section.settings.btn_vibrate %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('spot-promo-btn-{{ section.id }}');
      if (!btn) return;

      setInterval(function() {
        setTimeout(() => {
          btn.classList.add("animate__animated", "animate__shakeX");
        }, 250);

        setTimeout(() => {
          btn.classList.remove("animate__animated", "animate__shakeX");
        }, 1500);
      }, 5000); // toutes les 5 secondes (modifie si besoin)
    });
  </script>
{% endif %}


<section 
    id="discount-spot-{{ section.id }}" 
    class="discount-spot text-center {{ bg_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ visibility }}"
    
    {% if section.settings.bg_type == 'image' %}
        style="background-image: url('{{ section.settings.background_img.src | image_url }}'); 
               background-size: cover; 
               background-repeat: no-repeat; 
               background-position: center center;
               position: relative;"
    {% elsif section.settings.bg_type == 'custom' %}
        style="background: {{ section.settings.bg_gradient_color }};"
    {% endif %}>

    {% if section.settings.bg_type == 'image' %}
        <div class="background-overlay" 
             style="background: rgba(0, 0, 0, {{ section.settings.background_img_opacity }});">
        </div>
        <div class="background-overlay-blur" 
             style="backdrop-filter: blur({{ section.settings.background_img_blur }}px);
                    -webkit-backdrop-filter: blur({{ section.settings.background_img_blur }}px);">
        </div>
    {% endif %}
    
    <div class="{{ section.settings.container }} position-relative"
          {% if section.settings.container == 'container-fluid' %}
              style="max-width: {{ section.settings.max_width }}px;"
          {% endif %}>
        <div class="row align-items-center">
            <div class="col-lg-3">
                <{{ section.settings.heading_tag }} class="title mb-5 mb-lg-0 {{ section.settings.title_size }}">
                    {% if section.settings.title_strong %}
                      <strong>{{ section.settings.title | replace: '[', '<span>' | replace: ']', '</span>' }}</strong>
                    {% else %}
                      {{ section.settings.title | replace: '[', '<span>' | replace: ']', '</span>' }}
                    {% endif %}
                </{{ section.settings.heading_tag }}>
            </div>
            <div class="col-lg-6">
                <ul class="discount-spot-tiers mx-n2 mb-6 mb-lg-0">
                    {% for tier in section.blocks %}
                        <li {{ tier.shopify_attributes }}>
                            <span style="color: {{ tier.settings.spend_text_color }};">{{ tier.settings.spend_text }}</span>
                            <b style="color: {{ tier.settings.discount_text_color }};">{{ tier.settings.discount_text }}</b>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="col-lg-3">
                <a 
                  id="spot-promo-btn-{{ section.id }}"
                  class="btn w-75 fs-5 mb-n4 mb-lg-0 {{ section.settings.btn_color }} {{ btn_shadow_sp }} {{ section.settings.btn_size }}" href="{{ section.settings.btn_url }}">
                    {{ section.settings.btn_text }}
                </a>
            </div>
        </div>
    </div>
</section>



