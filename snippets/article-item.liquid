{% liquid
    case section.settings.article_img_orientation
        when 'square'
            assign img_width  = 600
            assign img_height = 600
        when 'landscape'
            assign img_width  = 600
            assign img_height = 480
        when 'landscape-2'
            assign img_width  = 600
            assign img_height = 400
        when 'landscape-3'
            assign img_width  = 600
            assign img_height = 300
        when 'portrait'
            assign img_width  = 480
            assign img_height = 600
    endcase

    assign classes = ''
    if section.settings.enable_border == false
        assign classes = classes | append: 'border-0 '
    else
        assign classes = classes | append: section.settings.border_color | append: ' ' 
        assign classes = classes | append: 'border-' | append: section.settings.border_width | append: ' ' 
    endif
    assign classes = classes | append: section.settings.shadow_sp | append: ' ' 
    assign classes = classes | strip
%}

{% comment %}
{% if section.settings.blog.articles == blank %}
    {% for i in (1..3) %}
        <li class="article-item p-3 p-lg-4">
            <div class="card h-100 text-start rounded {% unless section.settings.animation == '' %}animate__animated opacity-0 {{ section.settings.animation_speed }}{% endunless %} {{ classes }}"
                 data-animate-class="{{ section.settings.animation }}"
                 style="animation-delay: {{ index | times: 150 }}ms;">
                {% assign placeholder_image_index = i %}
                {{ 'blog-apparel-' | append: placeholder_image_index | placeholder_svg_tag: 'placeholder-svg product-item-img bg-light rounded-top' }}
                <div class="card-body">
                    <h3 class="title h5 mb-0">
                        {{ 'Article de blog' }}
                    </h3>
                    <div class="article-excerpt rte small mt-3">
                        {{ 'Donnez à vos clients un résumé de votre article de blog' }}
                    </div>
                </div>
            </div>
        </li>
    {% endfor %}
{% else %}{% endcomment %}
    <li class="article-item p-3 p-lg-4">
        <div class="card h-100 text-start rounded {{ classes }}">
            <a class="" href="{{ article.url }}" tabindex="-1">
                <img
                    class="img-fluid card-img-top"
                    src="{{ article.image.src | image_url: width: img_width, height: img_height }}"
                    alt="{{ article.image.alt | escape }}"
                    width="{{ img_width }}"
                    height="{{ img_height }}"
                    loading="lazy">
            </a>
            <div class="card-body">
                <h3 class="title {{ section.settings.article_title_size }} mb-0">
                    <a href="{{ article.url }}" class="">
                        {{ article.title }}
                    </a>
                </h3>
                <p class="article-meta small text-muted mt-3 mb-2">
                    {% if section.settings.article_meta_author %}
                        {{ article.author }}
                    {% endif %}
                    {% if section.settings.article_meta_date %}
                        @ {{ article.created_at | time_tag: '%d %b, %Y' }}
                    {% endif %}
                </p>
                {% if section.settings.article_excerpt %}
                    <div class="article-excerpt rte small mt-3">
                        {{ article.excerpt }}
                    </div>
                {% endif %}
            </div>
        </div>
    </li>
{% comment %}{% endif %}{% endcomment %}