{% liquid
    if block == nil
        assign block = section.blocks | where: 'type', 'notify' | first
        assign is_below_gallery = true
    endif
    
    assign mt = block.settings.mt | prepend: 'mt-'
    assign mb = block.settings.mb | prepend: 'mb-'
%}

{% if block %}
    <div 
        id="notification-{{ block.id }}"
        class="enter-view
        {% if is_below_gallery %}
            {% if block.settings.show_below_gallery_desktop %}
                d-none d-lg-flex
            {% else %}
                d-none
            {% endif %}
        {% else %}
            {% if block.settings.show_below_gallery_desktop %}
                d-lg-none
            {% endif %}
        {% endif %}
         {{ mt }} {{ mb }}"
        >

        <div 
            class="{% unless block.settings.animation == '' %}animate__animated opacity-0 {{ block.settings.animation_speed }}{% endunless %}"
            data-animate-class="{{ block.settings.animation }}">
        
            {% unless block.settings.slide_link == blank %}
                <a href="{{ block.settings.slide_link }}" style="text-decoration: none; color: inherit;">
            {% endunless %}
            
            <div id="product-block-notify-{{ suffix }}" 
                class="alert {{ block.settings.alert_color }} alert-dismissible fade show rounded"
                role="alert"
                style="border-style: dashed; border-width: medium;" {{ block.shopify_attributes }}>
            
                <div class="d-flex align-items-start">
                    {% if block.settings.icon %}
                        <div class="me-3">
                            {{ block.settings.icon }}
                        </div>
                    {% endif %}
                    <div>
                        {% unless block.settings.title == blank %}
                            <h4 class="alert-heading {{ block.settings.title_size }}">
                                {{ block.settings.title }}
                            </h4>
                        {% endunless %}
                        {% unless block.settings.description == blank %}
                            <p class="small mb-0">
                                {{ block.settings.description }}
                            </p>
                        {% endunless %}
                        {% unless block.settings.notice == blank %}
                            <hr style="color: currentColor !important;">
                            <p class="extra-small mb-0">{{ block.settings.notice }}</p>
                        {% endunless %}
                    </div>
                </div>
            
                {% if block.settings.show_close_button %}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                {% endif %}
                
            </div>

            {% unless block.settings.slide_link == blank %}
                </a>
            {% endunless %}
        </div>
    </div>
{% endif %}


