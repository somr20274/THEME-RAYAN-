{% unless product.metafields.custom.product_gallery_promo_title == blank %}
    <div 
        class="product-gallery-promo-text"
        data-bs-container="body" 
        data-bs-toggle="popover" 
        data-bs-placement="top" 
        data-bs-trigger="hover focus"
        data-bs-custom-class="product-gallery-promo-text-tooltip"
        data-bs-content="{{ product.metafields.custom.description_promo_galerie_produit }}"
        style="background-color: {{ section.settings.product_gallery_promo_background_color | default: settings.color_primary }};
               color: {{ section.settings.product_gallery_promo_text_color | default: settings.color_body_text }};">
        <div class="mb-0">
            {{ product.metafields.custom.product_gallery_promo_title }}
        </div>
        <div class="d-flex align-items-center">
            {{ 'product.promo_learn_more' | t }}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-info-circle ms-2" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
            </svg>
        </div>
    </div>
{% endunless %}